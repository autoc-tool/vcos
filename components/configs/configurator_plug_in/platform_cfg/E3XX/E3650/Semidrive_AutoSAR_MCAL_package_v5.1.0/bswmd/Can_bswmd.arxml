                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="801394e1-35f9-49b2-a748-f7f0d989a556">
                      <SHORT-NAME>CanMessageBufferRegionConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">can mailbox divide two message buffer, determind the message size, in one region the message may be different.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <!-- @Calculated /AUTOSAR/TOP-LEVEL-PACKAGES/TS_T01D20M1I4R0/ELEMENTS/Can/CanConfigSet/CanController/CanController/CanMessageBufferRegionConfig: MAX(XPath: ecu:get(concat(&apos;RegionConfigNum.&apos;, string(num:inttohex(node:value(../CanControllerBaseAddress))))))-->
                      <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
                      <!-- @CalculatedEnd -->
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="8e1eaf45-f6bf-446a-b7b5-0242631f105f">
                          <SHORT-NAME>CanMessageBufferRegionName</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">message buffer region name.</L-2>
                          </DESC>
                          <ORIGIN>SemiDrive</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
