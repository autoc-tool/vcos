                  <UPPER-MULTIPLICITY>24</UPPER-MULTIPLICITY>
                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="1e3010bb-8459-4e52-8200-a72b4b5dcca6">
                      <SHORT-NAME>CanControllerActivation</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines if a CAN controller is used in the configuration.</L-2>
                      </DESC>
