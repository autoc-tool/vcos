                      <SHORT-NAME>VCanSendDropIntEnable</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines if a VCAN controller could generate interrupt when send packet is dropped</L-2>
                      </DESC>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>SEMIDRIVE</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
