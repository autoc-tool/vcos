                </ECUC-REFERENCE-DEF>
                <ECUC-REFERENCE-DEF UUID="fe75f1af-00c1-4ff6-9cff-27b6c73da5c7">
                  <SHORT-NAME>CanSupportTTCANRef</SHORT-NAME>
