                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c1b95d57-4ba1-468a-9760-60515bac8051">
                          <SHORT-NAME>CanLegacyRxFifoTable</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    This container contains a multiple entry ID table information required to configure RX FIFO. The number of entries shall be equal to the number of RxFifo filters configured using CanLegacyRxFifoFiltersNumber parameter.
                                                    &lt;h1&gt;Note&lt;/h1&gt;This container is ENABLED only when CanControllerLegacyRxFifoEnable is TRUE.
                                                    Explanation regarding the individual mask usage&lt;br&gt;

                                                    &lt;table border=&quot;1&quot;&gt;
                                                    &lt;tr&gt;
                                                    &lt;th&gt;Number of Rx FIFO filters&lt;/th&gt;
                                                    &lt;th&gt;Rx FIFO ID Filter Table Elements Affected by Rx Individual Masks&lt;/th&gt;
                                                    &lt;th&gt;Rx FIFO ID Filter Table Elements Affected by Rx FIFO Global Mask&lt;/th&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_8&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-7&lt;/td&gt;
                                                    &lt;td&gt;none&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_16&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-9&lt;/td&gt;
                                                    &lt;td&gt;Elements 10-15&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_24&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-11&lt;/td&gt;
                                                    &lt;td&gt;Elements 12-23&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_32&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-13&lt;/td&gt;
                                                    &lt;td&gt;Elements 14-31&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_40&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-15&lt;/td&gt;
                                                    &lt;td&gt;Elements 16-39&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_48&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-17&lt;/td&gt;
                                                    &lt;td&gt;Elements 18-47&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_56&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-19&lt;/td&gt;
                                                    &lt;td&gt;Elements 20-55&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_64&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-21&lt;/td&gt;
                                                    &lt;td&gt;Elements 22-63&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_72&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-23&lt;/td&gt;
                                                    &lt;td&gt;Elements 24-71&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_80&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-25&lt;/td&gt;
                                                    &lt;td&gt;Elements 26-79&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_88&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-27&lt;/td&gt;
                                                    &lt;td&gt;Elements 28-87&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_96&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-29&lt;/td&gt;
                                                    &lt;td&gt;Elements 30-95&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_104&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-31&lt;/td&gt;
                                                    &lt;td&gt;Elements 32-103&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_112&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-31&lt;/td&gt;
                                                    &lt;td&gt;Elements 32-111&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_120&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-31&lt;/td&gt;
                                                    &lt;td&gt;Elements 32-119&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;tr&gt;
                                                    &lt;td&gt;FILTERS_NUMBER_128&lt;/td&gt;
                                                    &lt;td&gt;Elements 0-31&lt;/td&gt;
                                                    &lt;td&gt;Elements 32-127&lt;/td&gt;
                                                    &lt;/tr&gt;
                                                    &lt;/table&gt;
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <PARAMETERS>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:787544b7-bb53-494f-9a00-e1f5e51b56a8">
                              <SHORT-NAME>CanIDValue0</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                                        Specifies an ID to be used as acceptance criteria for the ID Table 0.
                                                        &lt;h1&gt;Note&lt;/h1&gt;Implementation Specific parameter. Value for this parameter should be enterd based on the CanControllerLegacyIDAcceptanceMode selected as explained below.&lt;br&gt;

                                                        &lt;h1&gt;A      &lt;/h1&gt;:  One full ID (standard or extended) per filter element.&lt;br&gt;
                                                        &lt;h1&gt;B      &lt;/h1&gt;:  One full standard ID if the CanTableIDType is Standard or one 14 most significant bit value of Extended ID if the CanTableIDType is Extended.&lt;br&gt;
                                                        &lt;h1&gt;C      &lt;/h1&gt;:  One 8 most significant bit value of  Standard or Extended ID.&lt;br&gt;
                                                    &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Flagchip</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>255</DEFAULT-VALUE>
                              <MAX>536870911</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:978b0f30-0ac0-439a-b7ad-4f756e685e08">
                              <SHORT-NAME>CanIDValue1</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                                        Specifies an ID to be used as acceptance criteria for the ID Table.&lt;br&gt;
                                                        &lt;h1&gt;Note&lt;/h1&gt;Implementation Specific parameter. Value for this parameter should be enterd based on the CanControllerLegacyIDAcceptanceMode selected as explained below.&lt;br&gt;

                                                        &lt;h1&gt;B      &lt;/h1&gt;:   One full standard ID if the CanTableIDType is Standard or one 14 most significant bit value of Extended ID if the CanTableIDType is Extended.&lt;br&gt;
                                                        &lt;h1&gt;C      &lt;/h1&gt;:   One 8 most significant bit value of  Standard or Extended ID.&lt;br&gt;
                                                    &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Flagchip</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>255</DEFAULT-VALUE>
                              <MAX>536870911</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ecfa9abd-00e5-42e6-8e21-ac5691b00c98">
                              <SHORT-NAME>CanIDValue2</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                                        Specifies an ID to be used as acceptance criteria for the ID Table.
                                                        &lt;h1&gt;Note&lt;/h1&gt;Implementation Specific parameter. Value for this parameter should be enterd based on the CanControllerLegacyIDAcceptanceMode selected as explained below.&lt;br&gt;
                                                        &lt;h1&gt;C  &lt;/h1&gt;:            One 8 most significant bit value of  Standard or Extended ID.&lt;br&gt;
                                                    &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Flagchip</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>255</DEFAULT-VALUE>
                              <MAX>536870911</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:0d831d5f-1c0d-4e69-a98a-3889fabd0422">
                              <SHORT-NAME>CanIDValue3</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                                        Specifies an ID to be used as acceptance criteria for the ID Table.
                                                        &lt;h1&gt;Note&lt;/h1&gt;Implementation Specific parameter. Value for this parameter should be enterd based on the CanControllerLegacyIDAcceptanceMode selected as explained below.&lt;br&gt;
                                                        &lt;h1&gt;C  &lt;/h1&gt;:            One 8 most significant bit value of  Standard or Extended ID.&lt;br&gt;
                                                    &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Flagchip</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>255</DEFAULT-VALUE>
                              <MAX>536870911</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:5cadca19-031f-44f9-a167-163d8876b7ec">
                              <SHORT-NAME>CanTableIDType</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                                        Specifies whether extended or standard frames are accepted into the FIFO.&lt;br&gt;
                                                        &lt;h1&gt;Note&lt;/h1&gt;Implementation Specific parameter.
                                                    &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Flagchip</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>Standard</DEFAULT-VALUE>
                              <LITERALS>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>Standard</SHORT-NAME>
                                  <ORIGIN>Flagchip</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>Extended</SHORT-NAME>
                                  <ORIGIN>Flagchip</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c286b1bb-23a0-4837-ad01-686ab227a7b4">
                              <SHORT-NAME>CanMBFilterMaskValue</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                                        Specifies Filetr Mask value to be used as acceptance criteria for the ID Table.&lt;br&gt;
                                                        &lt;h1&gt;Note&lt;/h1&gt;Implementation Specific parameter. Value for this parameter should be entered based on the CanControllerLegacyIDAcceptanceMode selected as explained below.&lt;br&gt;
                                                        &lt;h1&gt;A &lt;/h1&gt;: Filtermask value for One full standard or Extended ID based on the CanTableIDType selected.&lt;br&gt;
                                                        &lt;h1&gt;B &lt;/h1&gt;: Filtermask value for CanIDValue0(bit field: 0-10 for standard ID type and 0-13 for extended ID type) and CanIDValue1 (bit field: 11-21 for standard ID type and 14-27 for extended ID type).&lt;br&gt;
                                                        &lt;h1&gt;C &lt;/h1&gt;: Filtermask value for CanIDValue0(bit field: 0-8), CanIDValue1(bit field: 9-16), CanIDValue2(bit field: 17-24) and CanIDValue3(bit field: 25-32).&lt;br&gt;
                                                    &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Flagchip</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>2047</DEFAULT-VALUE>
                              <MAX>4294967295</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:4bb48baa-0899-4e3a-a423-8f5922fad297">
                      <SHORT-NAME>CanEnhancedRxFifo</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                            This container contains the configuration (parameters) of the CAN Enhanced RX FIFO.&lt;br&gt;
                                            &lt;h1&gt;Note&lt;/h1&gt;This container is ENABLED only when CAN FD is enabled.
                                        &lt;/html&gt;</L-2>
                      </DESC>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:18a1b801-8f52-4280-a312-c53b95de1926">
                          <SHORT-NAME>CanControllerEnhancedRxFifoEnable</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                Defines if Enhanced FIFO feature of CAN controller is used in the configuration.&lt;br&gt;
                                                Only used in CAN FD Mode.&lt;br&gt;
                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:2cd15539-8c8c-4330-bf2e-2b65157b031e">
                          <SHORT-NAME>CanHardwareObjectUsesPolling</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables polling of this fifo hardware object. This node shall exist if CanRxProcessing is set to MIXED.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e89bc8e5-7439-4811-8945-f912cbf3d7ea">
                          <SHORT-NAME>CanStandardIDFilterNumber</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                CAN Enhanced Rx FIFO standard ID filter Number
                                                NOTICE: standard ID filter Number + 2 * Extended ID filter Number &lt;= 32 (the vales is 72 in FC73008MDQ)
                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>2</DEFAULT-VALUE>
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanEnhancedRxFifo/CanStandardIDFilterNumber: INVALID(XPath: (../CanControllerEnhancedRxFifoEnable = &apos;false&apos;) or .&lt;=num:i(ecu:get(&apos;Can.CanCommon.CanController.NoERFFEL&apos;)), (../CanControllerEnhancedRxFifoEnable = &apos;false&apos;) or .&gt;=2, (../CanControllerEnhancedRxFifoEnable = &apos;false&apos;) or ((num:i(.) mod num:i(2)) = num:i(0)), (../CanControllerEnhancedRxFifoEnable = &apos;true&apos;) and (num:i(.) + num:i(../CanExtendedIdFilterNumber)*num:i(2)) &gt; num:i(32), (../CanControllerEnhancedRxFifoEnable = &apos;true&apos;) and (num:i(count(node:filter(../CanEnhancedRxFifoTable/*, &apos;node:value(./CANEnhancedFifoFilterIdType) = node:value(./StandardString)&apos;))) != num:i(node:value(../CanStandardIDFilterNumber))))-->
                          <MAX>65535</MAX>
                          <MIN>0</MIN>
                          <!-- @CalculatedEnd -->
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f5b50f8c-7080-4f9c-9709-120012954007">
                          <SHORT-NAME>CanExtendedIdFilterNumber</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                CAN Enhanced Rx FIFO Extended ID filter Number
                                                NOTICE: standard ID filter Number + 2 * Extended ID filter Number &lt;= 32
                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0</DEFAULT-VALUE>
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanEnhancedRxFifo/CanExtendedIdFilterNumber: INVALID(XPath: (../CanControllerEnhancedRxFifoEnable = &apos;false&apos;) or .&lt;=num:i(ecu:get(&apos;Can.CanCommon.CanController.NoERFFEL&apos;)) div 2, (../CanControllerEnhancedRxFifoEnable = &apos;false&apos;) or .&gt;=0, (../CanControllerEnhancedRxFifoEnable = &apos;true&apos;) and (num:i(.)*num:i(2) + num:i(../CanStandardIDFilterNumber)) &gt; num:i(32), (../CanControllerEnhancedRxFifoEnable = &apos;true&apos;) and (../CanControllerEnhancedRxFifoEnable = &apos;true&apos;) and (num:i(count(node:filter(../CanEnhancedRxFifoTable/*, &apos;node:value(./CANEnhancedFifoFilterIdType) = node:value(./ExtendedString)&apos;))) != num:i(node:value(../CanExtendedIdFilterNumber))))-->
                          <MAX>65535</MAX>
                          <MIN>0</MIN>
                          <!-- @CalculatedEnd -->
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:0ed95f4c-6414-44ab-92b8-dc2ed945c53b">
                          <SHORT-NAME>CanFifoWatermark</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                This field defines the minimum number of CAN messages stored in the Enhanced RX FIFO.
                                                When that number is reached, then Interrupt or DMA request would be generated if the interrupt or DMA is enabled.
                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1</DEFAULT-VALUE>
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanEnhancedRxFifo/CanFifoWatermark: INVALID(XPath: .&lt;=12, .&gt;=1)-->
                          <MAX>9223372036854775807</MAX>
                          <MIN>-9223372036854775808</MIN>
                          <!-- @CalculatedEnd -->
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:a6ee8170-eaa1-4e99-b4d5-654315121221">
                          <SHORT-NAME>CanEnhancedRxFifoSplitHrh</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    if this is checked, every enhanced rx fifo filter element has one hardware object id
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-FUNCTION-NAME-DEF UUID="ECUC:5ac4f8fe-c684-408e-8640-318c8602dcf1">
                          <SHORT-NAME>CanRxFifoWarningNotification</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                            Set here the name of the handler for RxFifo Warning notification function.
                                            &lt;h1&gt;Note&lt;/h1&gt;Implementation Specific parameter&lt;/h1&gt;&lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                            <ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                              <DEFAULT-VALUE>NULL_PTR</DEFAULT-VALUE>
                            </ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                          </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                        </ECUC-FUNCTION-NAME-DEF>
                        <ECUC-FUNCTION-NAME-DEF UUID="ECUC:69369c2f-5126-4d70-ba1a-7ef260aef978">
                          <SHORT-NAME>CanRxFifoOverflowNotification</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">
                                            &lt;html&gt;
                                            Set here the name of the handler for RxFifo Overflow notification function.
                                            &lt;h1&gt;Note&lt;/h1&gt;Implementation Specific parameter&lt;/h1&gt;&lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                            <ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                              <DEFAULT-VALUE>NULL_PTR</DEFAULT-VALUE>
                            </ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                          </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                        </ECUC-FUNCTION-NAME-DEF>
                      </PARAMETERS>
                      <REFERENCES>
                        <ECUC-REFERENCE-DEF UUID="ECUC:3fe2b43e-5ae2-4ff2-beaf-50a1de9855ba">
                          <SHORT-NAME>CanMainFunctionRWPeriodRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                ECUC_Can_00438 :Reference to CAN Controller to which the HOH is associated to.&lt;br&gt;
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Can/CanGeneral/CanMainFunctionRWPeriods</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                      </REFERENCES>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:0666a268-d1ab-4044-96f3-8d1c8fdbaf95">
                          <SHORT-NAME>CanEnhancedRxFifoTable</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt; CAN Enhanced Rx FIFO ID Filter Table
                                                    &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
