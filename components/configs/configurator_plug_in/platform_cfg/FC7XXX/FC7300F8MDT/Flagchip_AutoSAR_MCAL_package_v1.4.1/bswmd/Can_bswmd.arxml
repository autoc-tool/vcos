                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Mcu/McuModuleConfiguration/McuClockSettingConfig/McuClockReferencePoint</DESTINATION-REF>
                    </ECUC-REFERENCE-DEF>
                    <ECUC-REFERENCE-DEF UUID="ECUC:8dd5559b-f43d-4fb9-958a-8c1ac43136a7">
                      <SHORT-NAME>CanWakeupSourceRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                            ECUC_Can_00359: This parameter contains a reference to the Wakeup Source for this controller as defined in the ECU State Manager.&lt;br&gt;
                                            Type: reference to EcuM_WakeupSourceType&lt;br&gt;
                                            EcuM plugin need to be added and then give the reference to it.&lt;br&gt;
                                        &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <REQUIRES-SYMBOLIC-NAME-VALUE>true</REQUIRES-SYMBOLIC-NAME-VALUE>
                      <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/EcuM/EcuMConfiguration/EcuMCommonConfiguration/EcuMWakeupSource</DESTINATION-REF>
                    </ECUC-REFERENCE-DEF>
                  </REFERENCES>
                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e9498c43-a9d6-4240-8e3c-3f36bb60d7cf">
                      <SHORT-NAME>CanControllerBaudrateConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">&lt;html&gt;
                                              ECUC_Can_00387: This container contains bit timing related configuration parameters of the CAN controller(s).&lt;br&gt;
                                          &lt;/html&gt;</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>1</UPPER-MULTIPLICITY-INFINITE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bc786611-5f6f-4984-9b40-05c1c79e0093">
                          <SHORT-NAME>CanModuleClock</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    Can baudrate source clock, if CLK_SRC set 1, is from Module clock, or is from function clock ( Divided from OSC by PCC )
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanModuleClock: DEFAULT(XPath: node:when(../../../CanClockFromBus=&apos;true&apos;, num:i(node:ref(../../../CanCpuModuleClockRef)/McuClockReferencePointFrequency),num:i(node:ref(../../../CanCpuFunctionClockRef)/McuClockReferencePointFrequency) ))-->
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanModuleClock: INVALID(XPath: node:when(../../../CanClockFromBus=&apos;true&apos;, num:i(node:ref(../../../CanCpuModuleClockRef)/McuClockReferencePointFrequency) != node:value(.), num:i(node:ref(../../../CanCpuFunctionClockRef)/McuClockReferencePointFrequency) != node:value(.) ))-->
                          <MAX>9223372036854775807</MAX>
                          <MIN>-9223372036854775808</MIN>
                          <!-- @CalculatedEnd -->
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:746e8472-44ae-4ec1-a8c8-e4d5bc271adf">
                          <SHORT-NAME>CanControllerBaudRate</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    ECUC_Can_00005: Specifies the buadrate of the controller in kbps.&lt;br&gt;
                                                    CAN maximum speed is 1Mbps.&lt;br&gt;
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>500</DEFAULT-VALUE>
                          <MAX>2000</MAX>
                          <MIN>0</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f4981a74-cc53-49b3-8d67-8581a7fc202f">
                          <SHORT-NAME>CanControllerBaudRateConfigID</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    ECUC_Can_00471: Uniquely identifies a specific baud rate configuration. This ID is used by
                                                    SetBaudrate API&lt;br&gt;
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>ECU</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanControllerBaudRateConfigID: DEFAULT(XPath: node:fallback(node:current()/../@index, num:i(1)))-->
                          <MAX>65535</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:b35931be-4775-4ef0-b631-f8858f718528">
                          <SHORT-NAME>CanControllerPrescaller</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    Specifies the prescaller for the controller .&lt;br&gt;
                                                    The calculation of the resulting CanControllerTimeQuanta value depending on module clocking and prescaller shall be done offline.&lt;br&gt;
                                                    Prescaler = FreqCanClk / FreqTq; FreqTq = 1 / CanControllerTimeQuanta .&lt;br&gt;
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>3</DEFAULT-VALUE>
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanControllerPrescaller: INVALID(XPath: not(node:exists(../CanControllerFdBaudrateConfig)) and ((. &gt; 1024) or (. &lt; 1)), node:exists(../CanControllerFdBaudrateConfig) and ((. &gt; 1024) or (. &lt; 1)), num:i(num:i(../CanModuleClock) mod num:i(.)) != 0)-->
                          <MAX>9223372036854775807</MAX>
                          <MIN>-9223372036854775808</MIN>
                          <!-- @CalculatedEnd -->
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:cb9aec6c-f081-4f39-9330-3c733204e182">
                          <SHORT-NAME>CanNeedTqs</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    Total Can Baud Tq num, and may set it in range 8-383 generally
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanNeedTqs: DEFAULT(XPath: num:i(../CanModuleClock div 1000 div ../CanControllerBaudRate div ../CanControllerPrescaller))-->
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanNeedTqs: INVALID(XPath: num:i(../CanModuleClock div 1000 div ../CanControllerBaudRate div ../CanControllerPrescaller) != node:value(.) or . &gt;300 or . &lt;8)-->
                          <MAX>9223372036854775807</MAX>
                          <MIN>-9223372036854775808</MIN>
                          <!-- @CalculatedEnd -->
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f6dda106-0ed3-4a63-ae63-7e7d34503163">
                          <SHORT-NAME>CanControllerSyncSeg</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    The Synchronization Segment or SYNC_SEG time interval is used to synchronize all the nodes across the network.&lt;br&gt;
                                                    The SYNC_SEG time interval has a fixed period of one Time Quantum (TQ).&lt;br&gt;
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1</DEFAULT-VALUE>
                          <MAX>1</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a92b1590-ab16-4e5c-a330-6005389b137a">
                          <SHORT-NAME>CanControllerPropSeg</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    ECUC_Can_00073: It is used to compensate the physical delay within the CAN network (CTRL[PROPSEG] - 0..7).&lt;br&gt;
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>7</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:963d2a43-f4a2-4629-8261-e8424d8870ad">
                          <SHORT-NAME>CanControllerSeg1</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    ECUC_Can_00074: Specifies the Phase Segment 1 in time quantas (ENCBT[NTSEG1] = 0..255).&lt;br&gt;
                                                    CanControllerSeg1 = (PSEG1 + 1) * Tq .&lt;br&gt;
                                                    The CanControllerSeg1 valid values are 1-256 Tq.&lt;br&gt;
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>4</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a0bdc81c-6d11-426f-b2d4-7992824770b3">
                          <SHORT-NAME>CanControllerSeg2</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    ECUC_Can_00075: Specifies the Phase Segment 1 in time quantas (ENCBT[NTSEG2] = 1..127).&lt;br&gt;
                                                    CanControllerSeg2 = (PSEG2 + 1) * Tq .&lt;br&gt;
                                                    The CanControllerSeg2 valid values are 2-128 Tq.&lt;br&gt;
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>4</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:b563fea5-9f20-467f-8003-9ba391c370e5">
                          <SHORT-NAME>CanControllerSyncJumpWidth</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    ECUC_Can_00383: Specifies the synchronization jump width for the controller in time quantas.
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>4</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:d0f1d49a-0fda-4cf7-9094-1e7b216302d0">
                          <SHORT-NAME>CanSamplePoint</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    CAN sample point: (1+TSEG1) / (1+TSEG1+TSEG2)
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanSamplePoint: DEFAULT(XPath: (1 + ../CanControllerPropSeg + ../CanControllerSeg1) div (1 + ../CanControllerPropSeg + ../CanControllerSeg1 + ../CanControllerSeg2))-->
                          <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanSamplePoint: INVALID(XPath: . &gt;1 or . &lt;0)-->
                          <MAX>100.0</MAX>
                          <MIN>0.0</MIN>
                          <!-- @CalculatedEnd -->
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6a442b0e-dd43-4cac-b09d-1bdf8e26a7c3">
                          <SHORT-NAME>CanTxArbitrationStartDelay</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    This 5-bit field indicates how many CAN bits the Tx arbitration process start point can be delayed from the first bit of CRC field on CAN bus.&lt;br&gt;
                                                    See Reference Manual to have a calculation method for the optimal TASD value.
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>20</DEFAULT-VALUE>
                          <MAX>63</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:eec06a8b-3110-4a65-8e88-c4b84caa896b">
                          <SHORT-NAME>CanControllerFdBaudrateConfig</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">&lt;html&gt;
                                                    ECUC_Can_00473: This optional container contains bit timing related configuration parameters of the CAN controller(s) for payload and CRC of a CAN FD frame. If this container exists the controller supports CAN FD frames.
                                                &lt;/html&gt;</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <PARAMETERS>
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:67b8a0ce-3dc0-46e7-84b2-7d1da0768182">
                              <SHORT-NAME>CanControllerFdBaudRate</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                                        ECUC_Can_00481.Specifies the data segment baud rate of the controller in kbps.
                                                    &lt;/html&gt;</L-2>
                              </DESC>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>1000</DEFAULT-VALUE>
                              <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanControllerFdBaudrateConfig/CanControllerFdBaudRate: INVALID(Range: &gt;=0, &lt;=num:i(ecu:get(&apos;Can.CanCommon.MaxFdBaudrateValue&apos;)))-->
                              <MIN>0</MIN>
                              <!-- @CalculatedEnd -->
                            </ECUC-FLOAT-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6f711d7c-5e20-49e7-a92a-7edcfd39da93">
                              <SHORT-NAME>CanControllerFdPrescaller</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                                        Specifies the fd prescaller for the controller .&lt;br&gt;
                                                        The calculation of the resulting CanControllerFdTimeQuanta value depending on module clocking and prescaller shall be done offline.&lt;br&gt;
                                                        Prescaler = FreqCanClk / FreqTq; FreqTq = 1 / CanControllerTimeQuanta .&lt;br&gt;
                                                    &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Flagchip</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>3</DEFAULT-VALUE>
                              <MAX>1024</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3e113ade-4aea-4b89-a838-a3aff2890151">
                              <SHORT-NAME>CanFdNeedTqs</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                                   Total Can Data Baud Tq num, and may set it in range 8-114 generally.
                                                &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Flagchip</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanControllerFdBaudrateConfig/CanFdNeedTqs: DEFAULT(XPath: num:i(../../CanModuleClock div 1000 div ../CanControllerFdBaudRate div ../CanControllerFdPrescaller))-->
                              <!-- @Calculated /FC7300FXXX/Can/CanConfigSet/CanController/CanControllerBaudrateConfig/CanControllerFdBaudrateConfig/CanFdNeedTqs: INVALID(XPath: num:i(../../CanModuleClock div 1000 div ../CanControllerFdBaudRate div ../CanControllerFdPrescaller) != node:value(.) or . &gt;48 or . &lt;5)-->
                              <MAX>9223372036854775807</MAX>
                              <MIN>-9223372036854775808</MIN>
                              <!-- @CalculatedEnd -->
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c5da2274-1c45-40f4-98c7-1986052a9d3e">
                              <SHORT-NAME>CanControllerFdSyncSeg</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">&lt;html&gt;
                                                        The Synchronization Segment or SYNC_SEG time interval is used to synchronize all the nodes across the network.&lt;br&gt;
                                                        The SYNC_SEG time interval has a fixed period of one Time Quantum (TQ).&lt;br&gt;
                                                    &lt;/html&gt;</L-2>
                              </DESC>
                              <ORIGIN>Flagchip</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>1</DEFAULT-VALUE>
                              <MAX>1</MAX>
