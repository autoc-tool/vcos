            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e1c13ae2-fcdf-40dd-8aa7-4a9a83b0b606">
              <SHORT-NAME>AutosarExt</SHORT-NAME>
              <DESC>
                <L-2 L="EN">&lt;html&gt;&lt;p&gt;Autosar Extension API settings.&lt;/p&gt;&lt;/html&gt;</L-2>
              </DESC>
              <PARAMETERS>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:015c00ff-7ff1-41c8-bf70-aa2844abf142">
                  <SHORT-NAME>CanSupportLegacyCanIfApi</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">&lt;html&gt;&lt;p&gt;Implements the support for CanIf APIs before AutoSAR 4.2.2.
                                     When enabled, the CanIf indication functions will follow the AutoSAR version 4.2.2 for forward compatbility.
                                     Otherwise, the API standard will follow AutoSAR R20-11.&lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>Flagchip</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                  <VALUE-CONFIG-CLASSES>
                    <ECUC-VALUE-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                    <ECUC-VALUE-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                  </VALUE-CONFIG-CLASSES>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d033e621-9cf8-4cc3-bdbe-a4bccc656699">
                  <SHORT-NAME>CanUseShortCanIdType</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">&lt;html&gt;&lt;p&gt;Implements the support for Can_IdType before AutoSAR 4.2.2.
                                     When it is enabled and CanExtendedIDSupport is disabled, the Can_IdType will be considered as uint16.
                                     Otherwise, it will be considered as uint32.&lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>Flagchip</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                  <VALUE-CONFIG-CLASSES>
                    <ECUC-VALUE-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                    <ECUC-VALUE-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                  </VALUE-CONFIG-CLASSES>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6b43a093-a9d1-5290-5b60-2aaf562002ed">
                  <SHORT-NAME>CanSupportLegacyPduInfoType</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">&lt;html&gt;&lt;p&gt;Implements the support for PduInfoType before AutoSAR 4.2.2.
                                     When it is enabled, the PduInfoType will be considered as AutoSAR 4.2.2 defined.
                                     Otherwise, it will be considered as AutoSAR 4.3.1 defined.&lt;/p&gt;&lt;/html&gt;</L-2>
                  </DESC>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>Flagchip</ORIGIN>
                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                  <VALUE-CONFIG-CLASSES>
                    <ECUC-VALUE-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                    <ECUC-VALUE-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                    </ECUC-VALUE-CONFIGURATION-CLASS>
                  </VALUE-CONFIG-CLASSES>
                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
          </CONTAINERS>
        </ECUC-MODULE-DEF>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
