                                                &lt;td&gt;Elements 32-127&lt;/td&gt;
                                                &lt;/tr&gt;
                                                &lt;/table&gt;
                                            &lt;/html&gt;</L-2>
                          </DESC>
                          <ORIGIN>Flagchip</ORIGIN>
