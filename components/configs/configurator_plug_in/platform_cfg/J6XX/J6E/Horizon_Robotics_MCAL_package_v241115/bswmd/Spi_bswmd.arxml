                  <SHORT-NAME>SwMinorVersion</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">&lt;html&gt;
                			 The minor version number implemented by the supplier for this module, which is a supplier specific number.
                			&lt;/html&gt;</L-2>
                  </DESC>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>HOBOT</ORIGIN>
