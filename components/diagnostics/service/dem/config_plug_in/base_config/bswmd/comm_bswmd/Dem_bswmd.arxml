                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:21b7ff17-6e56-4192-aa2a-88334ef038b6">
                          <SHORT-NAME>DemDtcValue</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Unique Diagnostic Trouble Code value for OBD</L-2>
                            <L-2 L="ZH">概述：DemDtcValue是用于定义诊断故障代码（DTC）的数值，它是故障诊断管理（Dem）模块中用于唯一标识每个故障的数字代码。</L-2>
                            <L-2 L="ZH">注意：在配置DemDtcValue时，需要确保每个故障代码的唯一性，避免不同故障之间的代码重复；根据ISO 14229-1标准选择合适的故障代码范围和格式；在AUTOSAR CP 4.4中，DemDtcValue的配置应遵循模块配置规范，确保与故障诊断需求的一致性。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00885</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX>65535</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3d82a2dd-0559-4262-8a58-b362d4df63dd">
                          <SHORT-NAME>DemJ1939DTCValue</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Unique Diagnostic Trouble Code value for J1939 (consisting of SPN and FMI)</L-2>
                            <L-2 L="ZH">概述：DemJ1939DTCValue配置项用于定义诊断故障代码（DTC）的值，这些值遵循J1939标准，用于在车辆诊断系统中标识特定的故障。</L-2>
                            <L-2 L="ZH">注意：在配置DemJ1939DTCValue时，必须确保使用的故障代码值符合J1939标准的定义；不同的故障代码应对应不同的系统或部件故障；在整个诊断系统中，每个DTC值必须是唯一的，避免冲突。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00892</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
