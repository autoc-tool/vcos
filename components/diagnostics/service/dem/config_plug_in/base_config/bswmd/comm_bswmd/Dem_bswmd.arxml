                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:6d03d9d3-d386-94ed-444c-8ec3a90a9b8a">
                              <SHORT-NAME>DEM_DTC_WWHOBD_CLASS_C</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
