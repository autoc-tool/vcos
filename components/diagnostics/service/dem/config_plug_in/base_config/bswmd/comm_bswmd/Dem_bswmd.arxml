                      <REFERENCES>
                        <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:51093c6a-9259-4c2a-9ac4-464c3e0a2274">
                          <SHORT-NAME>DemMemoryDestinationRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The memory destination assigns DTCs to one or two memory destinations. If more than one memory destination is assigned to a specific DTC, the DTC can be present in the corresponding event memories. In this case one of the references has to be DemMirrorMemory (SWS_Dem_CONSTR_6104).</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00890</RELATED-TRACE-ITEM-REF>
