                          </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:20f5eb7d-06e8-4f97-b842-47b9b216b8ad">
                          <SHORT-NAME>DemUserDefinedMemory</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container contains the user defined event memory specific parameters of the Dem module.</L-2>
                            <L-2 L="ZH">概述：DemUserDefinedMemory配置项用于定义诊断事件管理（DEM）模块中用户自定义的内存块，允许用户存储特定的诊断信息或状态。</L-2>
                            <L-2 L="ZH">注意：在配置DemUserDefinedMemory时，需确保内存大小和位置符合系统的内存管理策略和限制；用户定义的内存应避免与系统其他部分的内存区域冲突；此配置项在AUTOSAR CP 4.4标准中未明确定义，因此实现方式可能因AUTOSAR版本或供应商而异。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">DEM_CAPTURE_SYNCHRONOUS_TO_REPORTING</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00910</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>30</UPPER-MULTIPLICITY>
                          <PARAMETERS>
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:d2636896-194e-9b5b-58cc-4854ce38148f">
                              <SHORT-NAME>DemEnvironmentDataCapture</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">DemEnvironmentDataCapture defines the point in time, when the data actually is captured.</L-2>
                                <L-2 L="ZH">概述：DemEnvironmentDataCapture配置项用于定义诊断事件管理器（DEM）如何捕获和存储与诊断事件相关的环境数据，这些数据可以用于故障分析和后处理。</L-2>
                                <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，环境数据的捕获方式需要遵循DEM模块的配置规范；确保捕获的数据与诊断需求和内存资源限制相匹配；正确配置环境数据的触发条件和存储策略，以便在故障发生时有效地记录相关信息。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <ADMIN-DATA>
                                <SDGS>
                                  <SDG GID="VCOS:CfgUnrealized">
                                    <SD GID="VCOS:CfgLock">true</SD>
                                    <SD GID="VCOS:CfgValue">DEM_CAPTURE_SYNCHRONOUS_TO_REPORTING</SD>
                                  </SDG>
                                </SDGS>
                              </ADMIN-DATA>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00895</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <LITERALS>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:a43f2abc-8066-e943-dc43-d13905af5e9d">
                                  <SHORT-NAME>DEM_CAPTURE_ASYNCHRONOUS_TO_REPORTING</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:a8aa2f57-b3a6-e7ac-05a3-d4ba84658cd3">
                                  <SHORT-NAME>DEM_CAPTURE_SYNCHRONOUS_TO_REPORTING</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:81fea804-66d3-9334-3943-12da027536bb">
                              <SHORT-NAME>DemEventDisplacementStrategy</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This configuration switch defines, whether support for event displacement is enabled or not, and which displacement strategy is followed.</L-2>
                                <L-2 L="ZH">概述：DemEventDisplacementStrategy 配置项用于定义诊断事件管理（DEM）模块中，当事件内存空间不足时，用于确定哪些诊断事件将被替换或移除的策略。</L-2>
                                <L-2 L="ZH">注意：在配置时需确保策略符合系统的诊断需求和内存管理要求；选择的策略应当考虑到事件的优先级和频率，以避免重要事件的丢失；AUTOSAR CP 4.4标准可能提供了不同的替换策略，需要根据具体的系统需求选择合适的策略。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <ADMIN-DATA>
                                <SDGS>
                                  <SDG GID="VCOS:CfgUnrealized">
                                    <SD GID="VCOS:CfgLock">true</SD>
                                    <SD GID="VCOS:CfgValue">DEM_DISPLACEMENT_FULL</SD>
                                  </SDG>
                                </SDGS>
                              </ADMIN-DATA>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00742</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <LITERALS>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:2af1caf1-d73b-e214-ccea-6504116f5ee3">
                                  <SHORT-NAME>DEM_DISPLACEMENT_FULL</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:94a74fe3-c254-df45-cca3-813eb7ec8026">
                                  <SHORT-NAME>DEM_DISPLACEMENT_NONE</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b2288d37-b038-dfda-e68b-ea4b4754e374">
                                  <SHORT-NAME>DEM_DISPLACEMENT_PRIO_OCC</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:d16ac816-99d0-91f3-77e5-20ba54be410f">
                              <SHORT-NAME>DemEventMemoryEntryStorageTrigger</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Configures the primary trigger to allocate an event memory entry.</L-2>
                                <L-2 L="ZH">概述：DemEventMemoryEntryStorageTrigger配置项用于定义诊断事件存储的触发条件，这决定了何时将诊断事件存入非易失性存储器中。</L-2>
                                <L-2 L="ZH">注意：在配置时需确保触发条件与系统的诊断策略相符合；AUTOSAR CP 4.4标准可能对存储触发条件的可用选项有特定的限制或要求；正确配置此项对于遵守法规要求和确保诊断信息在断电后依然可用是至关重要的。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <ADMIN-DATA>
                                <SDGS>
                                  <SDG GID="VCOS:CfgUnrealized">
                                    <SD GID="VCOS:CfgLock">true</SD>
                                    <SD GID="VCOS:CfgValue">DEM_TRIGGER_ON_TEST_FAILED</SD>
                                  </SDG>
                                </SDGS>
                              </ADMIN-DATA>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00797</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>DEM_TRIGGER_ON_TEST_FAILED</DEFAULT-VALUE>
                              <LITERALS>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:ab3ab6f2-ef69-db98-1f8e-afed9d676b01">
                                  <SHORT-NAME>DEM_TRIGGER_ON_CONFIRMED</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:79682007-b2f8-d279-1011-7adcece204bf">
                                  <SHORT-NAME>DEM_TRIGGER_ON_FDC_THRESHOLD</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:a5ae0d8c-f81a-de84-274e-d18350233719">
                                  <SHORT-NAME>DEM_TRIGGER_ON_TEST_FAILED</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:ef7f94c1-5112-940a-659c-3ac15affc8eb">
                              <SHORT-NAME>DemOccurrenceCounterProcessing</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This configuration switch defines the consideration of the fault confirmation process for the occurrence counter. For OBD and mixed systems (OBD/non OBD, refer to DemOBDSupport) configuration switch shall always set to DEM_PROCESS_OCCCTR_TF.</L-2>
                                <L-2 L="ZH">概述：DemOccurrenceCounterProcessing 是一个配置项，用于定义诊断事件管理（DEM）模块中事件发生次数计数器的处理方式，它决定了如何对事件发生的次数进行跟踪和管理。</L-2>
                                <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，需要确保该配置项与系统中的诊断需求相匹配；配置的处理方式应当支持所需的故障记忆策略，例如故障次数阈值；此外，还需注意该配置项对非易失性存储器（NVRAM）的使用和管理，因为事件发生次数可能需要在车辆断电后保持。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <ADMIN-DATA>
                                <SDGS>
                                  <SDG GID="VCOS:CfgUnrealized">
                                    <SD GID="VCOS:CfgLock">true</SD>
                                    <SD GID="VCOS:CfgValue">DEM_PROCESS_OCCCTR_TF</SD>
                                  </SDG>
                                </SDGS>
                              </ADMIN-DATA>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00767</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <LITERALS>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:9beefc27-7975-d45c-1d3b-2d71e72edae5">
                                  <SHORT-NAME>DEM_PROCESS_OCCCTR_CDTC</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:dc900228-79e8-da6e-0977-dc6f332dbab3">
                                  <SHORT-NAME>DEM_PROCESS_OCCCTR_TF</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:594bb992-be20-9615-5b84-c29bfbaa1f6a">
                              <SHORT-NAME>DemTypeOfFreezeFrameRecordNumeration</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter defines the type of assigning freeze frame record numbers for event-specific freeze frame records.</L-2>
                                <L-2 L="ZH">概述：DemTypeOfFreezeFrameRecordNumeration 配置项用于定义诊断事件管理（DEM）模块中冻结帧记录编号的枚举类型，这决定了冻结帧数据如何与诊断事件关联。</L-2>
                                <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，需确保冻结帧记录编号的唯一性和一致性；此配置项通常与车辆制造商的诊断策略紧密相关，因此需要根据具体的OEM要求进行配置；在实现时，应注意与DTC（Diagnostic Trouble Code）的关联性和冻结帧数据的存储策略。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <ADMIN-DATA>
                                <SDGS>
                                  <SDG GID="VCOS:CfgUnrealized">
                                    <SD GID="VCOS:CfgLock">true</SD>
                                    <SD GID="VCOS:CfgValue">DEM_FF_RECNUM_CALCULATED</SD>
                                  </SDG>
                                </SDGS>
                              </ADMIN-DATA>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00778</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
