                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:812ce464-9d5c-9487-4acd-01d68fad20bd">
                              <SHORT-NAME>DEM_TRIGGER_ON_PASSED</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:3c753bf8-c9b0-9224-39f7-d5b761408df2">
                              <SHORT-NAME>DEM_TRIGGER_ON_PENDING</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4007958d-fb13-978d-6582-0ae401855972">
