                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:a7a5cf5c-1e35-ce4a-ce5d-602d3850921a">
                                  <SHORT-NAME>SINT16_N</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:64a03839-7df7-88d5-4c3f-6a25c74d60f9">
                                  <SHORT-NAME>SINT32</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:57c31f42-afc4-d6c9-eaf4-5f32ef2aa5e0">
                                  <SHORT-NAME>SINT32_N</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:be74f199-1a04-86a7-4be9-0113923d1360">
                                  <SHORT-NAME>SINT8</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b2e76ca1-a121-d68f-e5ec-4ab2313e094f">
                                  <SHORT-NAME>SINT8_N</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:6563aa07-63e7-876a-496e-e29263b0b0ec">
                                  <SHORT-NAME>UINT16</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4381dd8b-9c81-d0e6-d066-47a170ca98a4">
                                  <SHORT-NAME>UINT16_N</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:e1797f16-382f-9058-28ff-0863b0f58d0f">
                                  <SHORT-NAME>UINT32</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:5775487a-7622-d460-b809-0d761240c02f">
                                  <SHORT-NAME>UINT32_N</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b0a0f5b5-750e-891e-48c2-f609c9a7d7f8">
                                  <SHORT-NAME>UINT8</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:99c5724d-a5d2-d839-e6a2-8bc51b570e64">
                                  <SHORT-NAME>UINT8_N</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:ccdad70a-e417-49cb-b2f5-ba55fd055f02">
                              <SHORT-NAME>DemDataElementEndianness</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Defines the endianness of the data belonging to an external data.</L-2>
                                <L-2 L="ZH">概述：DemDataElementEndianness 配置项用于指定诊断数据元素的字节序，确保数据在不同系统间正确交换，可以是大端（Big Endian）或小端（Little Endian）。</L-2>
                                <L-2 L="ZH">注意：在配置时需确保与ECU硬件架构的字节序一致；若数据元素在网络上交换，还需考虑网络协议对字节序的要求；AUTOSAR CP 4.4标准中应保持与其他配置项的一致性，避免字节序混淆导致的数据解释错误。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">If no DemDataElementEndianness is defined the value of DemDataElementDefaultEndianness is applicable.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00841</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <LITERALS>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:19b0fdc5-dade-85ed-3026-45ced58f97b8">
                                  <SHORT-NAME>BIG_ENDIAN</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:56fb8c1c-c5b7-921a-5c18-8f00cfd76856">
                                  <SHORT-NAME>LITTLE_ENDIAN</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:d8e767bc-814b-93a4-442e-3be4f78c30a2">
                                  <SHORT-NAME>OPAQUE</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7072c21a-d437-4e2a-a2bf-c7bd4a21f458">
                              <SHORT-NAME>DemDataElementArraySize</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">If the data element is an array data element, it defines the number of elements in the array. Note that this is not the size in bytes.</L-2>
                                <L-2 L="ZH">概述：DemDataElementArraySize 配置项用于定义诊断事件管理（DEM）中数据元素的数组大小，这决定了可以存储的数据量，例如故障码的快照数据。</L-2>
                                <L-2 L="ZH">注意：在配置时需确保数组大小符合实际需求，既不应过大浪费资源，也不应过小导致数据无法完整存储；此外，需注意与相关数据类型的兼容性和内存对齐要求；在AUTOSAR CP 4.4标准中，应检查此配置项是否与标准定义的数据类型和模块接口一致。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00967</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <MAX>4294967295</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                          <SUB-CONTAINERS>
                            <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:1113d69e-4b70-4756-bea7-2f74de625fcf">
                              <SHORT-NAME>DemDiagnosisScaling</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This container contains the configuration (parameters) of an alternative Diagnosis Representation. Out if this the scaling between Diagnosis and ECU internal representation and vice versa can be calculated.</L-2>
                                <L-2 L="ZH">概述：DemDiagnosisScaling 配置项用于定义诊断量表，它将内部故障检测参数映射到外部诊断工具可读取的标准化值，以便于故障诊断和数据解释。</L-2>
                                <L-2 L="ZH">注意：在配置DemDiagnosisScaling时，需要确保映射的准确性和合理性，以便故障代码能够正确地反映出实际的故障情况；此外，应当遵循AUTOSAR标准中对于量表映射的具体规定，包括量表的表示范围和精度；最后，要注意与故障存储和报告机制的兼容性，确保故障信息能够被正确记录和传递。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00843</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <CHOICES>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c494d1bc-6807-4116-868f-139fc9d4056c">
                                  <SHORT-NAME>DemAlternativeDataInterface</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container contains the configuration (parameters) of an alternative Diagnosis Representation by the means of a VariableDataPrototoype in a DataInterface.</L-2>
                                    <L-2 L="ZH">概述：DemAlternativeDataInterface配置项用于定义诊断事件管理器（DEM）中，替代数据接口的属性，这包括用于存储和检索与特定诊断事件相关的替代数据的接口配置。</L-2>
                                    <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保替代数据接口的配置与系统中实际使用的诊断事件和相关数据存储机制相匹配；替代数据接口的配置应当考虑数据的大小和格式，以确保兼容性和性能；配置时应注意数据保护和安全性要求，避免敏感信息泄露。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">Additionally a reference to PortInterfaceMapping can be defined which provide already the mapping rules between the VariableDataPrototoype in a DataInterface used by the software component (DemSRDataElementClass) and the intended Diagnosis Representation defined by DemExternalSRDataElementClass.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00844</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <REFERENCES>
                                    <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:a976f624-cf39-4827-bd93-dee061b141ee">
                                      <SHORT-NAME>DemDataElement</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Alternative Diagnosis Representation for the data defined by the means of a VariableDataPrototoype in a DataInterface.</L-2>
                                        <L-2 L="ZH">概述：DemDataElement配置项用于定义诊断事件管理器（DEM）中的数据元素，这些数据元素用于存储与诊断相关的信息，如错误码、快照数据等。</L-2>
                                        <L-2 L="ZH">注意：在配置DemDataElement时，需要确保数据元素的类型、大小和存储方式符合AUTOSAR CP 4.4标准；数据元素的唯一性要得到保证，避免在不同诊断事件中重复使用相同的数据元素标识符；还需注意数据元素的访问权限和存储条件，以确保数据的安全性和准确性。</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">The CompuMethod of the data type of the referenced VariableDataPrototype will be applied to the data type of the VariableDataPrototype in the interface used by the Dem.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00845</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <DESTINATION-TYPE>VARIABLE-DATA-PROTOTYPE</DESTINATION-TYPE>
                                    </ECUC-FOREIGN-REFERENCE-DEF>
                                    <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:2fa38569-4bc8-4f8a-be68-d40ed21fea34">
                                      <SHORT-NAME>DemPortInterfaceMapping</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Optional reference to PortInterfaceMapping which defines the mapping rules.</L-2>
                                        <L-2 L="ZH">概述：DemPortInterfaceMapping用于将诊断事件管理（DEM）模块中的事件与特定的端口接口进行映射，确保诊断信息能够通过正确的接口传输。</L-2>
                                        <L-2 L="ZH">注意：在配置DemPortInterfaceMapping时，需确保每个诊断事件唯一对应一个端口接口，避免映射冲突；此配置项对于实现DEM模块与其他软件组件间的通信至关重要，应仔细设计；AUTOSAR CP 4.4标准中对于DEM的配置和接口有详细规定，需遵循标准以保证兼容性。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">The PortInterfaceMapping is used to get the DataPrototypeMapping that describes a conversion between the data prototype referenced by DemDataElement and the data prototype referenced from DcmDspExternalSRDataElementClass.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00846</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <MULTIPLICITY-CONFIG-CLASSES>
                                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      </MULTIPLICITY-CONFIG-CLASSES>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <DESTINATION-TYPE>PORT-INTERFACE-MAPPING</DESTINATION-TYPE>
                                    </ECUC-FOREIGN-REFERENCE-DEF>
                                  </REFERENCES>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f403e75d-f752-4e3d-aa66-4d086335d59f">
                                  <SHORT-NAME>DemAlternativeDataType</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container contains the configuration (parameters) of an alternative Diagnosis Representation by the means of an ApplicationDataType.</L-2>
                                    <L-2 L="ZH">概述：DemAlternativeDataType配置项用于定义诊断事件管理器（DEM）中，替代数据类型的属性，这些属性用于存储与诊断事件相关的额外数据。</L-2>
                                    <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，必须确保替代数据类型与DEM组件的其他配置兼容；替代数据类型的定义应遵循DEM模块的数据类型规范；在定义替代数据类型时，应注意其对系统资源的影响，特别是内存和处理时间。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">Additionally the definition of a text table mapping can be a defined for ApplicationDataTypes that refers to a CompuMethod of category TEXTTABLE and
                                                                SCALE_LINEAR_AND_TEXTTABLE.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00847</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <REFERENCES>
                                    <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:438db0a6-b8c3-4e53-9e9f-fe7aa4530ed3">
                                      <SHORT-NAME>DemApplicationDataType</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Alternative Diagnosis Representation for the data defined by the means of a ApplicationDataType of category VALUE, BOOLEAN or ARRAY.</L-2>
                                        <L-2 L="ZH">概述：DemApplicationDataType用于定义诊断事件管理（DEM）中应用数据的类型，这些数据类型用于存储与特定诊断事件相关的附加信息。</L-2>
                                        <L-2 L="ZH">注意：在定义应用数据类型时，需要确保其与诊断事件的需求相匹配；数据类型的选择应支持故障诊断和系统监控的需求；在AUTOSAR CP 4.4标准中，需注意数据类型的兼容性和存储效率。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">The CompuMethod that applies to the referenced ApplicationDataType in case of category VALUE or BOOLEAN will be applied to the data type of the VariableDataPrototype in the interface used by the Dem.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00848</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <DESTINATION-TYPE>APPLICATION-DATA-TYPE</DESTINATION-TYPE>
                                    </ECUC-FOREIGN-REFERENCE-DEF>
                                  </REFERENCES>
                                  <SUB-CONTAINERS>
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:ade29ff5-d487-4137-8130-6a022b68d03d">
                                      <SHORT-NAME>DemTextTableMapping</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">The purpose of the DemDspTextTableMapping is to associate a texttable value defined in the context of the Dem to a texttable value defined in the context of a CompuMethod referenced by a DataType that shall be taken to create a dataElement in a SenderReceiverInterface. By this means it is possible to create a primitive version of a TexttableMapping (which can only be applied if a dataElement already exists).</L-2>
                                        <L-2 L="ZH">概述：DemTextTableMapping 用于定义故障管理系统中，故障码与文本描述之间的映射关系，确保系统能够提供准确的故障诊断信息。</L-2>
                                        <L-2 L="ZH">注意：在配置DemTextTableMapping时，确保每个故障码对应唯一的文本描述；此映射应与实际系统中的故障诊断需求一致；避免在运行时修改映射关系，以免引起系统行为不一致。</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">In other words, the DemDspTextTableMapping provides a similar mechanism to the TexttableMapping in a situation where the TexttableMapping cannot be applied since the SenderReceiverInterface for the PortPrototype on the Dem ServiceComponent does not yet exist.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00849</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                      <PARAMETERS>
                                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f0a03fa4-a957-4af0-aa3b-cf65572ff46d">
                                          <SHORT-NAME>DemDiagnosisRepresentationDataValue</SHORT-NAME>
                                          <DESC>
                                            <L-2 L="EN">The data value in the diagnosis representation.</L-2>
                                            <L-2 L="ZH">概述：DemDiagnosisRepresentationDataValue配置项用于定义诊断事件的数据值表示，它指定了与诊断事件相关联的数据元素的值，这些值可以用于故障码的存储和报告。</L-2>
                                            <L-2 L="ZH">注意：在配置DemDiagnosisRepresentationDataValue时，需要确保数据值与诊断事件的故障检测计数器和故障症状匹配；此外，应当遵循AUTOSAR标准中对数据值表示的格式和范围要求；在配置过程中，还需注意数据值的唯一性和一致性，以免在诊断通信中出现歧义。</L-2>
                                          </DESC>
                                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00851</RELATED-TRACE-ITEM-REF>
                                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                          <SCOPE>ECU</SCOPE>
                                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                          <VALUE-CONFIG-CLASSES>
                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                          </VALUE-CONFIG-CLASSES>
                                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                          <MAX>18446744073709551615</MAX>
                                          <MIN>0</MIN>
                                        </ECUC-INTEGER-PARAM-DEF>
                                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7af43f8d-e254-4f79-a572-ff3d72a8825b">
                                          <SHORT-NAME>DemInternalDataValue</SHORT-NAME>
                                          <DESC>
                                            <L-2 L="EN">The ECU internal data value.</L-2>
                                            <L-2 L="ZH">概述：DemInternalDataValue配置项用于定义诊断事件管理器（DEM）中的内部数据值，这些值用于存储与特定诊断事件相关的附加信息，如故障码的快照或环境数据。</L-2>
                                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，需确保每个DemInternalDataValue与特定的诊断事件唯一关联；配置时应注意数据类型和大小以避免内存溢出；此配置项的使用应结合实际的诊断需求和系统资源进行优化。</L-2>
                                            <L-2 L="ZH">该配置项未使用</L-2>
                                          </DESC>
                                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00850</RELATED-TRACE-ITEM-REF>
                                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                          <SCOPE>ECU</SCOPE>
                                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                          <VALUE-CONFIG-CLASSES>
                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                            <ECUC-VALUE-CONFIGURATION-CLASS>
                                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                            </ECUC-VALUE-CONFIGURATION-CLASS>
                                          </VALUE-CONFIG-CLASSES>
                                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                          <MAX>18446744073709551615</MAX>
                                          <MIN>0</MIN>
                                        </ECUC-INTEGER-PARAM-DEF>
                                      </PARAMETERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                  </SUB-CONTAINERS>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:73d20fb9-9b63-4cca-ac38-22c4f243a314">
                                  <SHORT-NAME>DemAlternativeDiagnosticDataElement</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container contains the configuration (parameters) of an alternative Diagnosis Representation by the means of Diagnostic Extract.</L-2>
                                    <L-2 L="ZH">概述：DemAlternativeDiagnosticDataElement配置项用于定义诊断事件的备选诊断数据元素，允许在不同情况下为同一诊断事件提供不同的诊断数据。</L-2>
                                    <L-2 L="ZH">注意：在配置时需确保备选诊断数据元素与主诊断数据元素兼容；备选数据元素的使用可能受到车辆配置或操作模式的限制；AUTOSAR CP 4.4标准中对于备选诊断数据的支持和配置要求应详细参考相关诊断管理模块的文档。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00934</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <REFERENCES>
                                    <ECUC-FOREIGN-REFERENCE-DEF UUID="ECUC:3e67ff86-33d2-4cd6-853a-5b61b8c9b33a">
                                      <SHORT-NAME>DemDiagnosticDataElementRef</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Alternative Diagnosis Representation for the data defined by the means of a DiagnosticDataElement in the Diagnostic Extract.</L-2>
                                        <L-2 L="ZH">概述：DemDiagnosticDataElementRef用于引用诊断数据元素，这些数据元素被用于存储和报告与特定故障码相关的附加信息。</L-2>
                                        <L-2 L="ZH">注意：确保引用的诊断数据元素与故障码正确匹配；在配置时考虑数据元素的存储和传输需求；AUTOSAR CP 4.4中，对于诊断数据元素的定义和引用应遵循标准的数据诊断模型。</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">This EcucForeignReference enables the access to all SwDataDefProps, in particular BaseType, CompuMethod and DataConstr

                                                                        The CompuMethod and DataConstr that applies to the referenced DiagnosticDataElement will be applied to the data type of the VariableDataPrototype in the interface used by the Dem.
                                                                        The mapped ImplementationDataType needs to match the given BaseType.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00935</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <DESTINATION-TYPE>DIAGNOSTIC-DATA-ELEMENT</DESTINATION-TYPE>
                                    </ECUC-FOREIGN-REFERENCE-DEF>
                                  </REFERENCES>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                              </CHOICES>
                            </ECUC-CHOICE-CONTAINER-DEF>
                            <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:cbfb18d6-1749-45e0-833d-34d9d30215d4">
                              <SHORT-NAME>DemSRDataElementClass</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This container defines the source of data in a provided port which shall be read for a external data element</L-2>
                                <L-2 L="ZH">概述：DemSRDataElementClass 是一个配置项，用于定义诊断事件记录的服务数据元素类别，它指定了用于存储和报告诊断信息的数据类型和属性。</L-2>
                                <L-2 L="ZH">注意：在配置DemSRDataElementClass时，需要确保数据类型与诊断需求相匹配，并且遵循AUTOSAR标准中对服务数据元素的定义和约束；此外，要注意数据元素的内存布局和对齐，以确保数据的正确读取和存储；在AUTOSAR CP 4.4标准中，可能会有对服务数据元素大小或编码方式的特定要求，需要仔细检查以确保兼容性。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">This container shall contain either one
                                                        DemSubElementInDataElementInstance
                                                        OR
                                                        DemDataElementInstance
                                                        OR
                                                        DemSubElementInImplDataElementInstance
                                                        reference.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00842</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <CHOICES>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1da3b6b3-d899-4105-96f5-eee7ed1ed32f">
                                  <SHORT-NAME>DemDataElementInstance</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Instance Reference to the primitive data in a port  where the data element is typed with an ApplicationPrimitveDataType or an ImplementationDataType.</L-2>
                                    <L-2 L="ZH">概述：DemDataElementInstance配置项用于定义诊断事件管理（DEM）中的数据元素实例，这些实例用于存储和传输与特定诊断事件相关的数据。</L-2>
                                    <L-2 L="ZH">注意：在配置DemDataElementInstance时，必须确保其类型与所需诊断信息兼容；数据元素的大小和格式应符合ECU的处理能力和存储限制；在AUTOSAR CP 4.4标准中，对于数据元素的命名和管理有明确的规范，需要遵循这些规范以保证系统的一致性和可维护性。</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00875</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <REFERENCES>
                                    <ECUC-INSTANCE-REFERENCE-DEF UUID="ECUC:a420975a-5a17-48de-ad73-d7082549c962">
                                      <SHORT-NAME>DemDataElementInstanceRef</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Instance Reference to the primitive data which shall be read or written.</L-2>
                                        <L-2 L="ZH">概述：DemDataElementInstanceRef 用于引用诊断事件管理器（DEM）中的数据元素实例，确保正确的数据关联和访问。</L-2>
                                        <L-2 L="ZH">注意：在配置DemDataElementInstanceRef时，必须确保引用的数据元素实例在DEM配置中存在且有效；引用错误可能导致诊断信息处理失败；应遵循AUTOSAR CP 4.4标准中对数据元素实例引用的具体规定和格式。</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">Supported are VariableDataPrototypes in SenderReceiverInterfaces and NvDataInterfaces and ParameterDataPrototypes in ParameterInterfaces (read only).
                                                                        This reference is applicable if the AutosarDataPrototype is typed with a ApplicationPrimitiveDataType of category VALUE or BOOLEAN or if the AutosarDataPrototype is typed with a ImplementationDataType of category VALUE or TYPE_REFERENCE that in turn boils down to VALUE</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00861</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <DESTINATION-CONTEXT>ROOT-SW-COMPOSITION-PROTOTYPE SW-COMPONENT-PROTOTYPE PORT-PROTOTYPE</DESTINATION-CONTEXT>
                                      <DESTINATION-TYPE>AUTOSAR-DATA-PROTOTYPE</DESTINATION-TYPE>
                                    </ECUC-INSTANCE-REFERENCE-DEF>
                                  </REFERENCES>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:5afd11aa-5406-45d4-b56a-6ea45ba3d010">
                                  <SHORT-NAME>DemSubElementInDataElementInstance</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Instance Reference to the primitve sub-element (at any level) of composite data in a port where the data element is typed with an ApplicationCompositeDataType.</L-2>
                                    <L-2 L="ZH">概述：DemSubElementInDataElementInstance 配置项用于定义诊断事件内存数据元素实例中的子元素，这些子元素用于存储特定的诊断信息，如故障码的状态或者环境数据。</L-2>
                                    <L-2 L="ZH">注意：在配置子元素时，需要确保其数据类型、大小和对齐方式符合AUTOSAR CP 4.4标准；子元素的配置应与诊断事件的内存布局保持一致，以确保正确的数据存取；在设计子元素时，考虑到数据的原子性和访问安全性，特别是在多任务或多核环境下。</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00874</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <REFERENCES>
                                    <ECUC-INSTANCE-REFERENCE-DEF UUID="ECUC:6b0b0abb-b972-44f8-aae4-c32fcb78a982">
                                      <SHORT-NAME>DemSubElementInDataElementInstanceRef</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Instance Reference to the primitve sub-element (at any level) of composite data in a port which shall be read or written.</L-2>
                                        <L-2 L="ZH">概述：DemSubElementInDataElementInstanceRef用于引用诊断事件内部的特定数据元素实例的子元素，这有助于精确地定位和诊断问题。</L-2>
                                        <L-2 L="ZH">注意：在配置时需确保引用的数据元素实例与子元素之间的关系正确无误；该配置项在AUTOSAR 4.4中可能受到特定模块或上下文的约束，需仔细检查适用性；引用错误可能导致诊断信息不准确或无法生成。</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">Supported are VariableDataPrototypes in SenderReceiverInterfaces and NvDataInterfaces and ParameterDataPrototypes in ParameterInterfaces (read only).
                                                                        This reference is applicable if the AutosarDataPrototype is typed with a ApplicationCompositeDataType.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00860</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <DESTINATION-CONTEXT>ROOT-SW-COMPOSITION-PROTOTYPE SW-COMPONENT-PROTOTYPE PORT-PROTOTYPE AUTOSAR-DATA-PROTOTYPE APPLICATION-COMPOSITE-ELEMENT-DATA-PROTOTYPE*</DESTINATION-CONTEXT>
                                      <DESTINATION-TYPE>APPLICATION-COMPOSITE-ELEMENT-DATA-PROTOTYPE</DESTINATION-TYPE>
                                    </ECUC-INSTANCE-REFERENCE-DEF>
                                  </REFERENCES>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c8bd6556-b5be-4c93-9be9-37a70a4d8424">
                                  <SHORT-NAME>DemSubElementInImplDataElementInstance</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Instance Reference to the primitve sub-element (at any level) of composite data in a port where the data element is typed with an ImplementationDataType of category STRUCTURE or ARRAY.</L-2>
                                    <L-2 L="ZH">概述：DemSubElementInImplDataElementInstance 用于定义诊断事件管理器中，实现数据元素实例中的子元素。</L-2>
                                    <L-2 L="ZH">注意：确保子元素与父数据元素的兼容性；子元素的定义应遵循AUTOSAR CP 4.4的数据模型规范；在配置时应注意数据一致性和完整性。</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00876</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <REFERENCES>
                                    <ECUC-INSTANCE-REFERENCE-DEF UUID="ECUC:ad862330-1bb1-40f6-816f-bf8b49e5c159">
                                      <SHORT-NAME>DemSubElementInImplDataElementInstanceRef</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Instance Reference to the primitve sub-element (at any level) of composite data in a port which shall be read or written.</L-2>
                                        <L-2 L="ZH">概述：DemSubElementInImplDataElementInstanceRef 配置项用于引用实现数据元素实例中的子元素，这通常用于故障诊断管理模块（Dem）中，以便于访问和管理特定的子数据元素。</L-2>
                                        <L-2 L="ZH">注意：在配置时需确保引用的子元素在实现数据元素实例中确实存在；应当注意子元素的类型和数据长度与引用时的兼容性；在配置故障诊断数据元素时，应遵循AUTOSAR的标准数据模型和诊断信息管理规范。</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">Supported are VariableDataPrototypes in SenderReceiverInterfaces and NvDataInterfaces and ParameterDataPrototypes in ParameterInterfaces (read only).
                                                                        This reference is applicable if the AutosarDataPrototype is typed with a ImplementationDataType of category STRUCTURE or ARRAY.
                                                                        Please note that in case of ARRAY the index attribute in the target reference has to be set to select a single array element.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00862</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <DESTINATION-CONTEXT>ROOT-SW-COMPOSITION-PROTOTYPE SW-COMPONENT-PROTOTYPE PORT-PROTOTYPE AUTOSAR-DATA-PROTOTYPE IMPLEMENTATION-DATA-TYPE-ELEMENT*</DESTINATION-CONTEXT>
                                      <DESTINATION-TYPE>IMPLEMENTATION-DATA-TYPE-ELEMENT</DESTINATION-TYPE>
                                    </ECUC-INSTANCE-REFERENCE-DEF>
                                  </REFERENCES>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                              </CHOICES>
                            </ECUC-CHOICE-CONTAINER-DEF>
                          </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3169b35f-f938-49a0-976c-91300ae5037d">
                          <SHORT-NAME>DemInternalDataElementClass</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This container contains the configuration (parameters) for an internal data element class.</L-2>
                            <L-2 L="ZH">概述：DemInternalDataElementClass配置项用于定义诊断事件管理（DEM）模块内部数据元素的属性，这些属性包括数据元素的类型、大小以及更新策略等。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，需确保每个DemInternalDataElementClass的定义与实际应用中的诊断需求相匹配；对于非标准数据类型，需要特别注意其内存对齐和大小定义；此配置项的修改应谨慎进行，以避免影响诊断数据的准确性和性能。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00684</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <PARAMETERS>
                            <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:fe434fc3-1ebf-40e6-9b79-a20a65a9dcf8">
                              <SHORT-NAME>DemInternalDataElement</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter defines the Dem-internal data value, which is mapped to the data element.</L-2>
                                <L-2 L="ZH">概述：DemInternalDataElement配置项用于定义诊断事件管理器（DEM）内部数据元素，这些数据元素用于存储与诊断事件相关的信息，如故障码、状态和计数器等。</L-2>
                                <L-2 L="ZH">注意：在配置DemInternalDataElement时，需要确保数据元素的类型、大小和对齐方式符合AUTOSAR标准和目标平台的要求；此外，数据元素的访问权限应当正确设置，以保护数据的完整性和安全性；在设计时还应考虑到数据元素的存储位置，以优化内存使用和访问效率。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00616</RELATED-TRACE-ITEM-REF>
