                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:2236d8b8-2712-47f4-9d0b-b77e5b5df6d7">
                      <SHORT-NAME>DemVersionInfoApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Activate/Deactivate the version information API.</L-2>
                        <L-2 L="ZH">概述：DemVersionInfoApi是一个配置项，用于启用或禁用诊断事件管理（DEM）模块的版本信息API，允许软件组件获取DEM模块的版本信息。</L-2>
                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，启用此API可能会增加代码的ROM大小，因此在资源受限的系统中使用时需谨慎；此配置项应根据项目需求和规范要求进行设置；确保在配置时遵循项目的软件架构和编码规范。</L-2>
                        <L-2 L="ZH">该配置项未使用</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">true: version information activated
                                        false: version information deactivated</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00721</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
