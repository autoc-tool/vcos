                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5cfc0dc1-0382-486c-90e9-a4db3dffae90">
                          <SHORT-NAME>DemDtcValue</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Unique Diagnostic Trouble Code value for UDS</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">(Range: 0x000000 and 0xFFFFFF are reserved for DTC groups by ISO 14229-1)</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00887</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
