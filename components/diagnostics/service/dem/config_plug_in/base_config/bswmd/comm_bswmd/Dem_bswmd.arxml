                              <LITERALS>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:ed2bb1be-821a-8ebb-3920-9a6307d1730f">
                                  <SHORT-NAME>DEM_INDICATOR_BLINKING</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:5daca4a6-e4a2-94da-42ad-81a2155b29aa">
                                  <SHORT-NAME>DEM_INDICATOR_BLINK_CONT</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:47b58546-dc96-92ea-1ef8-c0763ee52973">
                                  <SHORT-NAME>DEM_INDICATOR_CONTINUOUS</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:61d3b8f7-120a-96c1-3f12-b77182f842de">
                                  <SHORT-NAME>DEM_INDICATOR_FAST_FLASH</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:bb6f8658-3f11-9b36-28aa-e5c201c3862d">
                                  <SHORT-NAME>DEM_INDICATOR_SLOW_FLASH</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:bc2a7554-29fe-4a08-a8a8-57087833e55c">
                              <SHORT-NAME>DemIndicatorFailureCycleCounterThreshold</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Defines the number of failure cycles for the WarningIndicatorOnCriteria.</L-2>
                                <L-2 L="ZH">概述：DemIndicatorFailureCycleCounterThreshold 是用于定义故障指示器（如故障灯）在诊断事件管理（DEM）中，触发故障指示之前必须满足的连续故障循环次数阈值。</L-2>
                                <L-2 L="ZH">注意：该值应根据系统的诊断策略和法规要求来设置；过低的阈值可能导致频繁的误报，而过高的阈值可能导致故障指示延迟；在AUTOSAR CP 4.4标准中，确保该配置项与其他诊断相关配置项协同工作，以实现正确的故障指示逻辑。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00750</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <MAX>255</MAX>
                              <MIN>1</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:4248526d-57f1-4519-bb2d-400a541280f5">
                              <SHORT-NAME>DemIndicatorHealingCycleCounterThreshold</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Defines the number of healing cycles for the WarningIndicatorOffCriteria.</L-2>
                                <L-2 L="ZH">概述：DemIndicatorHealingCycleCounterThreshold 是一个用于诊断事件管理（Diagnostic Event Manager, DEM）的配置参数，它定义了一个阈值，该阈值指定了在故障指示灯（MIL, Malfunction Indicator Lamp）可以自动熄灭之前必须完成的治愈周期次数。</L-2>
                                <L-2 L="ZH">注意：该参数的设置应符合车辆的诊断策略和法规要求；过低的阈值可能导致故障指示灯过早熄灭，而过高的阈值可能导致故障指示灯长时间保持点亮，影响用户体验；在配置时应确保与其他相关的DEM参数（如Debounce算法和故障存储策略）协同工作。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00748</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <MAX>255</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                          <REFERENCES>
                            <ECUC-REFERENCE-DEF UUID="ECUC:328aa173-bf87-415a-a94c-8b48686226a6">
                              <SHORT-NAME>DemIndicatorRef</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to the used indicator.</L-2>
                                <L-2 L="ZH">概述：DemIndicatorRef用于引用故障指示器，它将特定的故障诊断管理（Diagnostic Event Manager, DEM）事件与相应的仪表盘警告灯（指示器）关联起来。</L-2>
                                <L-2 L="ZH">注意：确保每个DEM事件正确地映射到其对应的指示器上，避免错误或遗漏映射；在配置时需考虑指示器的可用性和兼容性，确保指示器能准确反映DEM事件状态；AUTOSAR CP 4.4标准中，指示器的引用和管理应遵循DEM模块的配置规范。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00687</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Dem/DemGeneral/DemEventMemorySet/DemIndicator</DESTINATION-REF>
                            </ECUC-REFERENCE-DEF>
                          </REFERENCES>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:224379f3-5144-410b-8255-c7c287b781ce">
                      <SHORT-NAME>DemMultiEventTriggering</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Configures an event that will trigger other events whenever the event is reported.</L-2>
                        <L-2 L="ZH">概述：DemMultiEventTriggering配置项用于定义诊断事件管理器（DEM）中多个诊断事件触发的行为，允许一个报警指示器（如故障灯）响应多个诊断事件的触发。</L-2>
                        <L-2 L="ZH">注意：在配置时需确保每个报警指示器能够正确映射到其对应的诊断事件；应考虑诊断事件之间的优先级，以便在多事件触发时正确管理报警指示器的状态；遵循AUTOSAR CP 4.4标准中关于诊断事件管理和报警指示器行为的规定。</L-2>
                        <L-2 L="ZH">该配置项未使用</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00944</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>65535</UPPER-MULTIPLICITY>
                      <REFERENCES>
                        <ECUC-REFERENCE-DEF UUID="ECUC:19befd3b-f0bd-4c89-8c48-e3902ec2f691">
                          <SHORT-NAME>DemMultiEventTriggeringMasterEventRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Reference to the event that will trigger other events upon reception of this event.</L-2>
                            <L-2 L="ZH">概述：DemMultiEventTriggeringMasterEventRef 配置项用于定义诊断事件管理器（DEM）中，一个多事件触发器的主事件引用，这允许将多个诊断事件关联到一个主事件，以便于集中处理和报告。</L-2>
                            <L-2 L="ZH">注意：在配置时需确保主事件引用对应一个有效的DEM事件ID；主事件通常是影响多个子事件的共同原因；在设计时应考虑事件之间的逻辑关系和依赖性，以确保诊断系统的准确性和有效性。</L-2>
                            <L-2 L="ZH">该配置项未使用</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00945</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                        <ECUC-REFERENCE-DEF UUID="ECUC:ed6787d8-e5df-4ea8-8faa-98779c255747">
                          <SHORT-NAME>DemMultiEventTriggeringSlaveEventRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Reference to the event that is triggered upon triggering the master event.</L-2>
                            <L-2 L="ZH">概述：DemMultiEventTriggeringSlaveEventRef配置项用于定义在多事件触发场景中，从属事件（Slave Event）的引用，这允许一个主事件（Master Event）与多个从属事件关联，以便在主事件发生时同时处理所有相关的从属事件。</L-2>
                            <L-2 L="ZH">注意：在配置时需确保从属事件正确地关联到相应的主事件；主从事件关系应符合系统的故障诊断逻辑；在AUTOSAR CP 4.4标准中，应检查该配置项是否与标准定义的属性和结构相一致。</L-2>
                            <L-2 L="ZH">该配置项未使用</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00946</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>255</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                      </REFERENCES>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e89a787a-51e6-4825-a754-45212c4e830a">
                      <SHORT-NAME>DemObdDTC</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This container contains the configuration (parameters) for DemObdDTC.</L-2>
                        <L-2 L="ZH">概述：DemObdDTC 是用于定义诊断故障代码（DTC）的配置，这些代码符合车辆诊断标准OBD（On-Board Diagnostics）。</L-2>
                        <L-2 L="ZH">注意：确保配置的DTC符合当前地区的OBD法规要求；在配置DTC时，应参照AUTOSAR标准中的错误代码和分类指南；不正确的DTC配置可能导致车辆不符合法规要求，影响车辆诊断系统的准确性和可靠性。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">false</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00884</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>65535</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:ade2dfbd-edda-4dba-82cf-889cca141ba3">
                          <SHORT-NAME>DemConsiderPtoStatus</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter is TRUE, when the event is affected by the Dem PTO handling.</L-2>
                            <L-2 L="ZH">概述：DemConsiderPtoStatus是一个配置项，用于决定诊断事件管理（DEM）模块是否考虑功率取出（PTO）状态在确定诊断故障码（DTC）状态时。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保此配置正确反映了系统对PTO状态的需求，因为它可能影响DTC的激活和存储；此配置项对于实现精确的故障诊断尤为重要；配置时需考虑系统的实际应用场景，以确保诊断准确性。</L-2>
                            <L-2 L="ZH">该配置项未使用</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00602</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:bd389f92-bcb8-4921-acc3-d96cb78371b6">
                          <SHORT-NAME>DemEventOBDReadinessGroup</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter specifies the Event OBD Readiness group for PID $01 and PID $41 computation.</L-2>
                            <L-2 L="ZH">概述：DemEventOBDReadinessGroup配置项用于定义诊断事件（DemEvent）所属的OBD（On-Board Diagnostics）就绪组，这有助于车辆满足特定的排放监测要求。</L-2>
                            <L-2 L="ZH">注意：在配置DemEventOBDReadinessGroup时，确保所选的就绪组符合相关排放标准和法规要求；不同地区的排放标准可能有所不同，需要根据目标市场进行配置；AUTOSAR CP 4.4标准中并未对OBD就绪组的具体分类和要求做出详细规定，需参考具体的OBD实施规范。</L-2>
                            <L-2 L="ZH">该配置项未使用</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">This parameter is only applicable for emission-related ECUs.</L-1>
                            </P>
                          </INTRODUCTION>
