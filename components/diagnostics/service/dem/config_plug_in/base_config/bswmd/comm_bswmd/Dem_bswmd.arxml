                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:6367c8f4-ddd6-8d00-4cdd-88006f014768">
                          <SHORT-NAME>DEM_EVCOMB_ONSTORAGE</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
