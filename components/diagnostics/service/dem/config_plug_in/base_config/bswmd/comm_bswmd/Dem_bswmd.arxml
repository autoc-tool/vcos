                              <SHORT-NAME>DURING_SHUTDOWN</SHORT-NAME>
                              <ORIGIN>AUTOSAR</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:7d812f77-4f55-9599-461f-2400947321ac">
                              <SHORT-NAME>IMMEDIATE_AT_FIRST_OCCURRENCE</SHORT-NAME>
                              <ORIGIN>AUTOSAR</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:6435b21e-779b-4886-9853-e4a77bd41c06">
                          <SHORT-NAME>DemWWHOBDDTCClass</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">DTC Class according to ISO 14229-1 [2013 version]. This parameter depends on the automotive manufacturer.</L-2>
                            <L-2 L="ZH">概述：DemWWHOBDDTCClass 是用于定义世界范围协调的车辆诊断（World Wide Harmonized On-Board Diagnostics, WWH-OBD）相关的故障诊断码（Diagnostic Trouble Code, DTC）的类别。</L-2>
                            <L-2 L="ZH">注意：在配置WWH-OBD DTC类别时，需要确保符合相关的法规要求；AUTOSAR CP 4.4标准中应详细定义了如何映射DTC到WWH-OBD类别；在不同地区可能有不同的法规要求，因此配置时应考虑目标市场的具体法规。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">DEM_DTC_WWHOBD_CLASS_NOCLASS</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">If it is not configured, the value is marked as 'unclassified'. If this parameter is configured for no DTC, the Dem provides no DTC WWHOBD class information.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00912</RELATED-TRACE-ITEM-REF>
