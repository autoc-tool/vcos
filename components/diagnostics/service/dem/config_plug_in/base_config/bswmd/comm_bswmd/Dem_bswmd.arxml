                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4bf203fe-832f-d85b-a20e-f5f99212f36e">
                                  <SHORT-NAME>UINT32_N</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:501a19d1-a5a2-8c78-3a3f-99a4c2d7440d">
                                  <SHORT-NAME>UINT8</SHORT-NAME>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:8e422dd1-b2df-dc34-d0a8-74489b2941a3">
