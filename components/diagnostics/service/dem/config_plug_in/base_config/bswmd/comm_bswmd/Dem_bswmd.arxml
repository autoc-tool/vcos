                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c005de82-ee68-46ba-8069-ed248a20b11b">
                          <SHORT-NAME>DemAgingCycleCounterThreshold</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Number of aging cycles needed to unlearn/delete the event.</L-2>
                            <L-2 L="ZH">概述：DemAgingCycleCounterThreshold 是一个配置项，用于定义诊断事件管理（DEM）中，一个故障存储条目在被视为老化之前必须经过的操作循环次数阈值。</L-2>
                            <L-2 L="ZH">注意：该值应当根据具体的车辆维修周期和预期的故障老化策略来设定；过低的阈值可能导致故障条目过早老化，而过高的阈值可能导致故障条目长时间保留；在配置时需要确保与其他相关的DEM参数（如DemAgingCycle）协同工作，以实现预期的故障管理策略。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00623</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>40</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:de47da90-b38f-41cd-9a78-9ff0ad3176fd">
                          <SHORT-NAME>DemAgingCycleCounterThresholdForTFSLC</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Number of aging cycles needed to reset the testFailedSinceLastClear Bit.</L-2>
                            <L-2 L="ZH">概述：DemAgingCycleCounterThresholdForTFSLC 是一个用于诊断事件管理（Diagnostic Event Manager）的配置参数，它定义了在特定操作周期内必须达到的老化周期计数器阈值，以便将故障存储器中的故障信号状态从“已确认”（Tested Failed Since Last Clear, TFSLC）转变为“未确认”。</L-2>
                            <L-2 L="ZH">注意：该阈值必须根据系统的诊断需求和老化策略来设定；过高或过低的阈值可能会影响故障码的准确老化和系统的诊断性能；在配置时需确保与其他相关的老化参数（如DemAgingCycle）协同工作，以保证老化机制的正确实施。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00897</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX>255</MAX>
                          <MIN>1</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3ef7c809-cd40-4824-b0cd-da79a594c75d">
                          <SHORT-NAME>DemDTCPriority</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Priority of the event/dtc, in view of full event memory. A lower value means higher priority.</L-2>
                            <L-2 L="ZH">概述：DemDTCPriority 配置项用于定义诊断故障码（DTC）的优先级，这个优先级决定了在多个DTC同时出现时，哪些DTC应该被首先报告。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，DTC优先级的取值范围通常是从1（最高优先级）到254（最低优先级），值255被保留用于表示DTC不可用或不支持；确保不同的DTC有不同的优先级，以避免在诊断通信中的优先级冲突；在配置DTC优先级时，应考虑故障的严重性和对车辆功能的影响。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00662</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>2</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:0c06d2a8-5789-4416-8c13-f331b2f5d081">
                          <SHORT-NAME>DemMaxNumberFreezeFrameRecords</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter defines the number of according freeze frame records, which can maximal be stored for this event. Therefore all these freeze frame records have the same freeze frame class.</L-2>
                            <L-2 L="ZH">概述：DemMaxNumberFreezeFrameRecords 配置项用于定义诊断事件管理（DEM）模块中，每个故障码（DTC）可以存储的最大冻结帧记录数。</L-2>
                            <L-2 L="ZH">注意：在设置此值时，需要考虑ECU的存储能力和需求，以确保不会超出内存限制；此配置项的值应该满足OBD要求（如果适用）；在AUTOSAR CP 4.4标准中，确保此配置项的值与其他相关DEM配置项保持一致性。</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">This parameter is only required for calculated record numeration (refer to DemTypeOfFreezeFrameRecordNumeration).</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Dem_00605</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
