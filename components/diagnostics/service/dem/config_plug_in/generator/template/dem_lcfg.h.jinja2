/*!*********************************************************************************************************************
 * @brief   定义dem_debounce_counter_based_type
 **********************************************************************************************************************/
typedef struct {
    boolean jump_up; ///< jump_up
    boolean jump_down; ///< jump_down
    uint16 increment_step_size; ///< 增长步长
    uint16 decrement_step_size; ///< 减少步长
    sint16 jump_down_value; ///< JumpDown值
    sint16 jump_up_value; ///< JumpUp值
    sint16 failed_threshold; ///< 失败阈值
    sint16 passed_threshold; ///< 成功阈值
} dem_debounce_counter_based_type;

/*!*********************************************************************************************************************
 * @brief   定义dem_debounce_time_based_type
 **********************************************************************************************************************/
typedef struct{
    uint16 index; ///< 标号
    uint32 time_failed_threshold; ///< 失败时间阈值
    uint32 time_passed_threshold; ///< 成功时间阈值
} dem_debounce_time_based_type;

/*!*********************************************************************************************************************
 * @brief   定义dem_debounce_algorithm_class_type
 **********************************************************************************************************************/
typedef struct {
    dem_debounce_name_type debounce_name; ///< 预去抖名
    union {
        const dem_debounce_counter_based_type *debounce_counter_based; ///< 基于计数预去抖
        const dem_debounce_time_based_type *debounce_time_based; ///< 基于时间预去抖
    } debounce_algorithm;
} dem_debounce_algorithm_class_type;

/*!*********************************************************************************************************************
 * @brief   定义DemEventClass
 **********************************************************************************************************************/
typedef struct {
    boolean ff_prestorage_supported; ///< 是否支持冻结帧预存储
    boolean aging_allowed; ///< 是否支持老化
    const uint8 failure_cycle_counter_threshold; ///< 确认Event转为Confirmed的门限值，操作周期计数failureCounter需要大于等于该值
    const uint8 aging_cycle_counter_threshold; ///< 确认Event老化的门限值，操作周期计数agingCounter需要大于等于该值
    uint8 event_priority; ///<  事件优先级
    dem_opcycle_id_type opcycle_ref; ///< 操作周期更新触发周期
    dem_opcycle_id_type aging_cycle_ref; ///< 老化计数更新触发周期
    dem_opcycle_id_type failure_cycle_ref; ///< 确认失效计数更新触发周期
    dem_dtc_origin_type event_destination; ///< 事件目标缓存区域（DemMemoryDestination）
{%- if dem_general.StorageConditionSupport == "STD_ON" %}
    const uint16 storage_condition_group_ref_index; ///< Event关联的StorageConditionGroup
{%- endif %}
{%- if dem_general.EnableConditionSupport == "STD_ON" %}
    const uint16 enable_condition_group_ref_index; ///< Event关联的EnableConditionGroup索引
{%- endif %}
{%- if dem_indicator_Attributes | length %}
    const uint16 indicator_attribute_index; ///< 指示器属性，用于警告灯
{%- endif %}
{% if dem_general.DemDebounceDisable == "STD_OFF" -%}
    const dem_debounce_algorithm_class_type *debounce_algorithm_class; ///< 故障状态的预去抖算法
{%- endif %}
} dem_event_class_type;

