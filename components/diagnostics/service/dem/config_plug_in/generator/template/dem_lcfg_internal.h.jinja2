/*!*********************************************************************************************************************
 * @brief   定义dem_ff_rec_type
 **********************************************************************************************************************/
typedef struct {
    dem_ff_kind_type kind;
    uint8 recnum; ///< 记录数
    uint16 data_size; ///< 数据大小
    dem_event_id_type event_id; ///< 事件ID
#if (DEM_EVENT_DISPLACEMENT_SUPPORT == STD_ON)
    uint32 timestamp; ///< 时间戳
#endif
    uint8 data[DEM_CFG_MAX_PRESTORE_FF_SIZE]; ///< 数据，长度为OBD冻结帧和UDS冻结帧的最大值
} dem_ff_rec_type;

/*!*********************************************************************************************************************
 * @brief   定义dem_prestore_entry_type
 **********************************************************************************************************************/
typedef struct {
    dem_event_id_type event_id; ///< 事件ID
    uint16 data_size; ///< 数据大小
    uint8 data[DEM_CFG_MAX_PRESTORE_FF_SIZE]; ///< 数据，预存储数据长度为OBD冻结帧和UDS冻结帧的最大值
} dem_prestore_entry_type;

/*!*********************************************************************************************************************
 * @brief   定义healing_rec_type
 **********************************************************************************************************************/
typedef struct {
    uint8 aging_cnt;  ///< 老化计数
    dem_event_id_type event_id; ///< 事件ID
} healing_rec_type;

/*!*********************************************************************************************************************
 * @brief   定义dem_event_info_rec_type
 **********************************************************************************************************************/
typedef struct {
    boolean failed_during_aging_cycle:1; ///< 老化周期期间失败
    boolean passed_during_aging_cycle:1; ///< 老化周期期间成功
    boolean failed_during_failure_cycle:1; ///< 失败周期期间失败
    boolean passed_during_failure_cycle:1; ///< 失败周期期间成功
    boolean error_status_changed:1; ///< 错误状态改变
{%- if dem_indicator_Attributes | length %}
    boolean indicator_data_changed:1; ///< 指示器数据改变
{%- endif %}
{%- if dem_general.DemAvailabilitySupport == "STD_ON" %}
    boolean is_available:1; ///< 可用性
{%- endif %}
{%- if dem_general.DataCyclesSinceLastFailed == "STD_ON" %}
    boolean cycles_since_last_failed_start:1; ///< 从上次失败起，DTC fdc 是否达到过其最大值
{%- endif %}
{%- if dem_general.DataCyclesSinceFirstFailed == "STD_ON" %}
    boolean cycles_since_first_failed_start:1; ///< 从首次失败起，DTC fdc 是否达到过其最大值
{%- endif %}
{%- if dem_general.DataFailedCycles == "STD_ON" %}
    boolean failed_cycles_start:1; ///< 错误周期开始
{%- endif %}
    boolean fdc_this_opcycle:1; ///< 当前操作周期是否达到FDC阈值
    boolean ext_data_stored:1; ///< 扩展数据已存储标记
{%- if dem_general.DataCurrentFdc == "STD_ON" %}
    sint8 uds_fdc; ///< uds_fdc
{%- endif %}
{%- if dem_general.DataMaxFdcDuringCurrentCycle == "STD_ON" %}
    sint8 max_uds_fdc; ///< 最大uds_fdc
{%- endif %}
    uint8 failure_counter; ///< 失败计数器
    uint8 aging_cnt; ///< 老化计数器
{%- if dem_general.DataAgedCounter == "STD_ON" %}
    uint8 aged_cnt; ///< 已老化的计数器
{%- endif %}
{%- if dem_general.DataCyclesSinceLastFailed == "STD_ON" %}
    uint8 cycles_since_last_failed; ///< 从 DTC fdc上次达到其最大值以来的操作周期数
{%- endif %}
{%- if dem_general.DataCyclesSinceFirstFailed == "STD_ON" %}
    uint8 cycles_since_first_failed; ///< 从 DTC fdc首次达到其最大值以来的操作周期数
{%- endif %}
{%- if dem_general.DataFailedCycles == "STD_ON" %}
    uint8 failed_cycles; ///< 失败周期数
{%- endif %}
#if (DEM_FF_DATA_IN_PRI_MEM)
    uint8 stored_ff_recnum; ///< 存储的冻结帧记录数
#endif
{%- if dem_general.DataOccurCounter == "STD_ON" %}
    uint8 occctr; ///< 发生
{%- endif %}
    dem_event_status_rec_type event_status_rec; ///<  事件状态记录
    dem_event_id_type event_id; ///< 事件ID
#if (DEM_DEBOUNCE_DISABLE == STD_OFF)
    sint16 local_fdc; ///< 本地fdc
#endif
    uint32 timestamp; ///< 时间戳
} dem_event_info_rec_type;

/*!*********************************************************************************************************************
 * @brief   定义dem_satellite_data_data_type
 **********************************************************************************************************************/
typedef struct
{
    dem_event_queue_status_type queue_status; ///< 队列状态
} dem_satellite_data_data_type;

/*!*********************************************************************************************************************
 * @brief   定义dem_satellite_data_type
 **********************************************************************************************************************/
typedef union {
    volatile dem_satellite_data_data_type data; ///< 数据
