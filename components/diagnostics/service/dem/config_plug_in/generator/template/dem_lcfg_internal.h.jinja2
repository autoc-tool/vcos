/*!*********************************************************************************************************************
 * @brief   定义基于时间去抖状态数据类型
 **********************************************************************************************************************/
typedef struct {
    uint32 debounce_time; ///< 去抖计时器，每至周期函数更新一次，达到门限值则去抖完成
    dem_event_id_type event_id; ///< 本去抖管理结构体对应的Event
    boolean started:1; ///< 计时器是否在计时中
    boolean failure_counting:1; ///< 计时器对应的EventStatus：FALSE - Failed / TRUE - Passed
    boolean error_reported:1; ///< 是否已经上报 - 在达到去抖时间门限转为FAILED/PASSED时置为TRUE
    boolean counter_reset:1; ///< 重置计时器后置为TRUE，第一次达到主周期函数时置为FALSE（重置后到第一次主周期函数时间间隔可能不足10ms，舍弃这段时间）
    dem_satellite_id_type satellite_id; ///< 卫星ID
} dem_time_base_status_data_type;

/*!*********************************************************************************************************************
 * @brief   定义基于时间去抖状态类型
 **********************************************************************************************************************/
typedef union {
    volatile dem_time_base_status_data_type data; ///< 数据
    volatile dem_atomic_word_type raw[2];  ///< 初始值
} dem_time_base_debounce_status_type;
#endif
#endif

