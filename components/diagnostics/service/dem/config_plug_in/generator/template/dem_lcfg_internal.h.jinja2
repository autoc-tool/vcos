/*!*********************************************************************************************************************
 * @brief   声明保存当前ClientId对应的信息，ClientId可以对应Event、DTCGroup或GroupMask等 - 此处使用一个联合体
 **********************************************************************************************************************/
typedef union {
    dem_event_id_type event_id; ///< 事件ID
    dem_dtc_group_id_type group_id; ///< 组Id
} dem_dtc_selector_selection_type;

/*!*********************************************************************************************************************
 * @brief   定义ClientId对应的Dem内部的Selector的信息
 **********************************************************************************************************************/
typedef struct {
    uint32 dtc; ///< DTC值
    dem_dtc_format_type dtc_format; ///< DTC格式
    dem_dtc_origin_type dtc_origin; ///< DTC起源
} dem_dtc_selector_request_type;

/*!*********************************************************************************************************************
 * @brief   定义dem_dtc_selector_data_type
 **********************************************************************************************************************/
typedef struct {
    boolean dtc_selector_is_set; ///< DTC选择器是否设置
    dem_dtc_selector_request_type request; ///< 请求类型
    dem_dtc_selector_selection_type selection; ///< 选择类型
    dem_dtc_selector_result_type selector_state; ///< 选择器状态
} dem_dtc_selector_data_type;

/*!*********************************************************************************************************************
 * @brief   定义dem_dtc_filter_type
 **********************************************************************************************************************/
typedef struct {
    dem_event_status_rec_type dtc_status_mask; ///< DTC状态掩码
    dem_dtc_origin_type dtc_origin; ///< DTC起源
    boolean filter_with_severity; ///< 严重性过滤
    dem_dtc_severity_type dtc_severity_mask; ///< 严重性掩码
    boolean filter_for_fault_detection_counter; ///< 故障检测计数过滤
    uint16 fault_index; ///< 故障索引
    dem_dtc_format_type dtc_format; ///< DTC格式
    boolean dtc_filter_is_set; ///< dtc设置过滤
} dem_dtc_filter_type;

/*!*********************************************************************************************************************
 * @brief   定义dem_ff_record_filter_type
 **********************************************************************************************************************/
typedef struct {
    boolean ff_rec_filter_is_set; ///< 冻结帧记录过滤是否设置
    dem_dtc_format_type dtc_format; ///< DTC格式
    uint16 ff_index; ///< 冻结帧索引
    uint32 event_index; ///< 事件索引
} dem_ff_record_filter_type;

