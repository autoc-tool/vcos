<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00046.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE UUID="1234567{#{dem_package["autosar_uuid"]}#}">
      <SHORT-NAME>AUTOSAR</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE UUID="1234567{#{dem_package["uuid"]}#}">
          <SHORT-NAME>{{dem_package["short_name"]}}</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE UUID="1234567{#{dem_package["datatypes_pkg"]["uuid"]}#}">
              <SHORT-NAME>DataTypes</SHORT-NAME>
              <ELEMENTS>
                {%- set data_types_elements_list =  dem_package["datatypes_pkg"]["elements"]%}
                {%- for data_types_element in data_types_elements_list %}
                <IMPLEMENTATION-DATA-TYPE UUID="1234567{#{data_types_element["uuid"]}#}">
                  <SHORT-NAME>{{data_types_element["short_name"]}}</SHORT-NAME>
                  {%- if "category" in data_types_element %}
                  <CATEGORY>{{data_types_element["category"]}}</CATEGORY>
                  {%- endif %}
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        {%- if "compu_method_ref" in data_types_element["sw_data_def"].keys()%}
                        <COMPU-METHOD-REF DEST="COMPU-METHOD">/AUTOSAR/Dem_swc/DataTypes/CompuMethods/{{data_types_element["sw_data_def"]["compu_method_ref"]}}</COMPU-METHOD-REF>
                        {%- endif %}
                        {%- if "data_constr_ref" in data_types_element["sw_data_def"].keys()%}
                        <DATA-CONSTR-REF DEST="DATA-CONSTR">/AUTOSAR/Dem_swc/DataTypes/DataConstrs/{{data_types_element["sw_data_def"]["data_constr_ref"]}}</DATA-CONSTR-REF>
                        {%- endif %}
                        {%- if "implementation_data_type" in data_types_element["sw_data_def"].keys()%}
                        {%- if data_types_element["sw_data_def"]["IsType"]|lower == "false" %}
                        <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/{{data_types_element["sw_data_def"]["implementation_data_type"]}}</IMPLEMENTATION-DATA-TYPE-REF>
                        {%- else %}
                        <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR/Dem_swc/DataTypes/{{data_types_element["sw_data_def"]["implementation_data_type"]}}</IMPLEMENTATION-DATA-TYPE-REF>
                        {%- endif %}
                        {%- endif %}
                        {%- if "calibration_access" in data_types_element["sw_data_def"].keys()%}
                        <SW-CALIBRATION-ACCESS>{{data_types_element["sw_data_def"]["calibration_access"]}}</SW-CALIBRATION-ACCESS>
                        {%- endif %}
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                  {%- if "sub_element" in data_types_element.keys()%}
                  <SUB-ELEMENTS>
                    <IMPLEMENTATION-DATA-TYPE-ELEMENT UUID="123456">
                      <SHORT-NAME>{{data_types_element["short_name"]}}Element</SHORT-NAME>
                      <CATEGORY>TYPE_REFERENCE</CATEGORY>
                      <ARRAY-SIZE>{{data_types_element["sub_element"]["array_size"]}}</ARRAY-SIZE>
                      <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                      <SW-DATA-DEF-PROPS>
                        <SW-DATA-DEF-PROPS-VARIANTS>
                          <SW-DATA-DEF-PROPS-CONDITIONAL>
                            <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/{{data_types_element["sub_element"]["element_type"]}}</IMPLEMENTATION-DATA-TYPE-REF>
                          </SW-DATA-DEF-PROPS-CONDITIONAL>
                        </SW-DATA-DEF-PROPS-VARIANTS>
                      </SW-DATA-DEF-PROPS>
                    </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  </SUB-ELEMENTS>
                  {%- endif %}
                </IMPLEMENTATION-DATA-TYPE>
                {%- endfor %}
              </ELEMENTS>
              <AR-PACKAGES>
                {%- set data_constrs =  dem_package["datatypes_pkg"]["data_constrs"] %}
                <AR-PACKAGE UUID="1234567{#{data_constrs["uuid"]}#}">
                  <SHORT-NAME>DataConstrs</SHORT-NAME>
                  <ELEMENTS>
                    {%- set data_constrs_elements_list = data_constrs["elements"] %}
                    {%- for data_constrs_element in data_constrs_elements_list %}
                    <DATA-CONSTR UUID="1234567{#{data_constrs_element["uuid"]}#}">
                      <SHORT-NAME>{{data_constrs_element["short_name"]}}</SHORT-NAME>
                      {%- set data_constrs_rules_list = data_constrs_element["data_constr_rules"] %}
                      <DATA-CONSTR-RULES>
                        {%- for data_constrs_rule in data_constrs_rules_list %}
                        <DATA-CONSTR-RULE>
                          <INTERNAL-CONSTRS>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">{{data_constrs_rule["internal_consters"]["lower_limit"]}}</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">{{data_constrs_rule["internal_consters"]["upper_limit"]}}</UPPER-LIMIT>
                          </INTERNAL-CONSTRS>
                        </DATA-CONSTR-RULE>
                        {%- endfor %}
                      </DATA-CONSTR-RULES>
                    </DATA-CONSTR>
                    {%- endfor %}
                  </ELEMENTS>
                </AR-PACKAGE>
                {%- set compu_methods = dem_package["datatypes_pkg"]["compu_methods"] %}
                <AR-PACKAGE UUID="1234567{#{compu_methods["uuid"]}#}">
                  <SHORT-NAME>CompuMethods</SHORT-NAME>
                  <ELEMENTS>
                    {%- set compu_methods_elements_list = compu_methods["elements"]%}
                    {%- for compu_methods_element in compu_methods_elements_list %}
                    <COMPU-METHOD UUID="1234567{#{compu_methods_element["uuid"]}#}">
                      <SHORT-NAME>{{compu_methods_element["short_name"]}}</SHORT-NAME>
                      <CATEGORY>{{compu_methods_element["category"]}}</CATEGORY>
                      <COMPU-INTERNAL-TO-PHYS>
                        <COMPU-SCALES>
                          {%- set compu_scale_list = compu_methods_element["compu_scales"]%}
                          {%- for compu_scale in compu_scale_list %}
                          <COMPU-SCALE>
                            <SHORT-LABEL>{{compu_scale["short_label"]}}</SHORT-LABEL>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">{{compu_scale["lower_limit"]}}</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">{{compu_scale["upper_limit"]}}</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>{{compu_scale["short_label"]}}</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          {%- endfor %}
                        </COMPU-SCALES>
                      </COMPU-INTERNAL-TO-PHYS>
                    </COMPU-METHOD>
                    {%- endfor %}
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
            {%- set interfaces_pkg = dem_package["interfaces_pkg"] %}
            <AR-PACKAGE UUID="1234567{#{interfaces_pkg["uuid"]}#}">
              <SHORT-NAME>Interfaces</SHORT-NAME>
              <ELEMENTS>
                {%- set client_server_interfaces_list = interfaces_pkg["client_server"]%}
                {%- if client_server_interfaces_list|length > 0 %}
                {%- for client_server_interface in client_server_interfaces_list %}
                <CLIENT-SERVER-INTERFACE UUID="1234567{#{client_server_interface["uuid"]}#}">
                  <SHORT-NAME>{{client_server_interface["short_name"]}}</SHORT-NAME>
                  <IS-SERVICE>{{client_server_interface["is_server"]|lower}}</IS-SERVICE>
                  <SERVICE-KIND>DIAGNOSTIC-COMMUNICATION-MANAGER</SERVICE-KIND>
                  <OPERATIONS>
                    {%- set interface_operations_list =  client_server_interface["operations"] %}
                    {%- for interface_operation in interface_operations_list %}
                    <CLIENT-SERVER-OPERATION UUID="1234567{#{interface_operation["uuid"]}#}">
                      <SHORT-NAME>{{interface_operation["short_name"]}}</SHORT-NAME>
                      <DESC>
                        <L-2 L="FOR-ALL"/>
                      </DESC>
                      <ARGUMENTS>
                        {%- set operation_arguments_list = interface_operation["arguments"]%}
                        {%- for operation_argument in operation_arguments_list %}
                        <ARGUMENT-DATA-PROTOTYPE UUID="1234567{#{operation_argument["uuid"]}#}">
                          <SHORT-NAME>{{operation_argument["short_name"]}}</SHORT-NAME>
                          <DESC>
                            <L-2 L="FOR-ALL"/>
                          </DESC>
                          {%- if operation_argument["IsType"]|lower == "true" %}
                          <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR/Dem_swc/DataTypes/{{operation_argument["TypeTref"]}}</TYPE-TREF>
                          {%- else %}
                          <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/{{operation_argument["TypeTref"]}}</TYPE-TREF>
                          {%- endif %}
                          <DIRECTION>{{operation_argument["Direction"]}}</DIRECTION>
                        </ARGUMENT-DATA-PROTOTYPE>
                        {%- endfor %}
                      </ARGUMENTS>
                      <POSSIBLE-ERROR-REFS>
                        {%- set error_refs_list = interface_operation["possible_errors"]%}
                        {%- for error_ref in error_refs_list %}
                        <POSSIBLE-ERROR-REF DEST="APPLICATION-ERROR">/AUTOSAR/Dem_swc/Interfaces/{{client_server_interface["short_name"]}}/{{error_ref}}</POSSIBLE-ERROR-REF>
                        {%- endfor %}
                      </POSSIBLE-ERROR-REFS>
                    </CLIENT-SERVER-OPERATION>
                    {%- endfor %}
                  </OPERATIONS>
                  <POSSIBLE-ERRORS>
                    {%- set possible_errors_list =  client_server_interface["possible_errors"] %}
                    {%- for possible_error in possible_errors_list %}
                    <APPLICATION-ERROR UUID="1234567{#{possible_error["uuid"]}#}">
                      <SHORT-NAME>{{possible_error["short_name"]}}</SHORT-NAME>
                      <ERROR-CODE>{{possible_error["error_code"]}}</ERROR-CODE>
                    </APPLICATION-ERROR>
                    {%- endfor %}
                  </POSSIBLE-ERRORS>
                </CLIENT-SERVER-INTERFACE>
                {%- endfor %}
                {%- endif %}
              </ELEMENTS>
            </AR-PACKAGE>
            {%- set componenttypes_pkg = dem_package["componenttypes_pkg"] %}
            {%- set main_function_runnable = componenttypes_pkg["main_function"] %}
            <AR-PACKAGE UUID="1234567{#{dem_package["componenttypes_pkg_uuid"]}#}">
              <SHORT-NAME>ComponentTypes</SHORT-NAME>
              <ELEMENTS>
{%- if "Dem" not in dem_package["Applications"] %}
                <SERVICE-SW-COMPONENT-TYPE UUID="1234567{#{componenttypes_pkg["uuid"]}#}">
                  <SHORT-NAME>Dem</SHORT-NAME>
                  <CATEGORY>SERVICE_COMPONENT</CATEGORY>
                  <PORTS>
                  </PORTS>
                  <INTERNAL-BEHAVIORS>
                  </INTERNAL-BEHAVIORS>
                </SERVICE-SW-COMPONENT-TYPE>
{%- endif %}
                {%- for application in dem_package["Applications"] %}
                {%- if "Dem" not in dem_package["Applications"] %}
                  {%- if "DemMaster_" in application %}
                  {%- set mainfunctionname = "Dem_MasterMainFunction" %}
                  {%- else %}
                  {%- set mainfunctionname = "Dem_SatelliteMainFunction" %}
                  {%- endif %}
                {%- else %}
                {%- set mainfunctionname = "Dem_MainFunction" %}
                {%- endif %}
                <SERVICE-SW-COMPONENT-TYPE UUID="1234567{#{componenttypes_pkg["uuid"]}#}">
                  <SHORT-NAME>{{application}}</SHORT-NAME>
                  <CATEGORY>SERVICE_COMPONENT</CATEGORY>
                  <PORTS>
                    {%- set pports_list = componenttypes_pkg["pports"] %}
                    {%- if pports_list|length > 0 %}
                    {%- for pport in pports_list %}
                    {%- if application in pport["Applications"] %}
                    <P-PORT-PROTOTYPE UUID="1234567{#{pport["uuid"]}#}">
                      <SHORT-NAME>{{pport["short_name"]}}</SHORT-NAME>
                      {%- if pport["interface_type"] == "client_server" %}
                      <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR/Dem_swc/Interfaces/{{pport["interface_ref"]}}</PROVIDED-INTERFACE-TREF>
                      {%- elif pport["interface_type"] == "sender_receiver" %}
                      <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/AUTOSAR/Dem_swc/Interfaces/{{pport["interface_ref"]}}</PROVIDED-INTERFACE-TREF>
                      {%- endif %}
                    </P-PORT-PROTOTYPE>
                    {%- endif %}
                    {%- endfor %}
                    {%- endif %}
                    {%- set rports_list = componenttypes_pkg["rports"] %}
                    {%- if rports_list|length > 0 %}
                    {%- for rport in rports_list %}
                    {%- if application in rport["Applications"] %}
                    <R-PORT-PROTOTYPE UUID="1234567{#{rport["uuid"]}#}">
                      <SHORT-NAME>{{rport["short_name"]}}</SHORT-NAME>
                      {%- if rport["interface_type"] == "client_server" %}
                      <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR/Dem_swc/Interfaces/{{rport["interface_ref"]}}</REQUIRED-INTERFACE-TREF>
                      {%- elif rport["interface_type"] == "sender_receiver" %}
                      <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/AUTOSAR/Dem_swc/Interfaces/{{rport["interface_ref"]}}</REQUIRED-INTERFACE-TREF>
                      {%- endif %}
                    </R-PORT-PROTOTYPE>
                    {%- endif %}
                    {%- endfor %}
                    {%- endif %}
                  </PORTS>
                  <INTERNAL-BEHAVIORS>
                    <SWC-INTERNAL-BEHAVIOR UUID="1234567{#{componenttypes_pkg["internal_behaviors_uuid"]}#}">
                      <SHORT-NAME>DemInternalBehavior</SHORT-NAME>
                      <EVENTS>
                        <TIMING-EVENT UUID="1234567{#{componenttypes_pkg["timing_event_uuid"]}#}">
                          <SHORT-NAME>Timer_{{mainfunctionname}}</SHORT-NAME>
                          <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/AUTOSAR/Dem_swc/ComponentTypes/{{application}}/DemInternalBehavior/{{mainfunctionname}}</START-ON-EVENT-REF>
                          <PERIOD>0.01</PERIOD>
                        </TIMING-EVENT>
                        {%- set operation_events_list = componenttypes_pkg["operation_events"] %}
                        {%- if operation_events_list|length > 0 %}
                        {%- for operation_event in operation_events_list %}
                        {%- if application in operation_event["Applications"] %}
                        <OPERATION-INVOKED-EVENT UUID="1234567{#{operation_event["uuid"]}#}">
                          <SHORT-NAME>{{operation_event["short_name"]}}</SHORT-NAME>
                          <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/AUTOSAR/Dem_swc/ComponentTypes/{{application}}/DemInternalBehavior/{{operation_event["start_on_event_ref"]}}</START-ON-EVENT-REF>
                          <OPERATION-IREF>
                            <CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/AUTOSAR/Dem_swc/ComponentTypes/{{application}}/{{operation_event["pport_ref"]}}</CONTEXT-P-PORT-REF>
                            <TARGET-PROVIDED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR/Dem_swc/Interfaces/{{operation_event["interface_ref"]}}/{{operation_event["operation_ref"]}}</TARGET-PROVIDED-OPERATION-REF>
                          </OPERATION-IREF>
                        </OPERATION-INVOKED-EVENT>
                        {%- endif %}
                        {%- endfor %}
                        {%- endif %}
                      </EVENTS>
                      <PORT-API-OPTIONS>
                        {%- if pports_list|length > 0 %}
                        {%- for pport in pports_list %}
                        {%- if application in pport["Applications"] %}
                        <PORT-API-OPTION>
                          <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                          <INDIRECT-API>false</INDIRECT-API>
                          <PORT-ARG-VALUES>
                            {%- for port_arg_value in pport["port_arg_values"] %}
                            <PORT-DEFINED-ARGUMENT-VALUE>
                              <VALUE>
                                {%- if "value" in port_arg_value %}
                                <NUMERICAL-VALUE-SPECIFICATION>
                                  <VALUE>{{port_arg_value["value"]}}</VALUE>
                                </NUMERICAL-VALUE-SPECIFICATION>
                                {%- endif %}
                              </VALUE>
                              {%- if "IsType" in port_arg_value and port_arg_value["IsType"]|lower == "true" %}
                              <VALUE-TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR/Dem_swc/DataTypes/{{port_arg_value["value_type_ref"]}}</VALUE-TYPE-TREF>
                              {%- else %}
                              <VALUE-TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/{{port_arg_value["value_type_ref"]}}</VALUE-TYPE-TREF>
                              {%- endif %}
                            </PORT-DEFINED-ARGUMENT-VALUE>
                            {%- endfor %}
                          </PORT-ARG-VALUES>
                          <PORT-REF DEST="P-PORT-PROTOTYPE">/AUTOSAR/Dem_swc/ComponentTypes/{{application}}/{{pport["short_name"]}}</PORT-REF>
                        </PORT-API-OPTION>
                        {%- endif %}
                        {%- endfor %}
                        {%- endif %}
                        {%- if rports_list|length > 0 %}
                        {%- for rport in rports_list %}
                        {%- if application in rport["Applications"] %}
                        <PORT-API-OPTION>
                          <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                          <INDIRECT-API>false</INDIRECT-API>
                          <PORT-REF DEST="R-PORT-PROTOTYPE">/AUTOSAR/Dem_swc/ComponentTypes/{{application}}/{{rport["short_name"]}}</PORT-REF>
                        </PORT-API-OPTION>
                        {%- endif %}
                        {%- endfor %}
                        {%- endif %}
                      </PORT-API-OPTIONS>
                      <RUNNABLES>
                        <RUNNABLE-ENTITY UUID="1234567{#{componenttypes_pkg["main_function"]["uuid"]}#}">
                          <SHORT-NAME>{{mainfunctionname}}</SHORT-NAME>
                          <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                          <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                          {%- set server_call_points = main_function_runnable["server_call_points"] %}
                          {%- if server_call_points|length > 0 %}
                          <SERVER-CALL-POINTS>
                            {%- for server_call_point in server_call_points %}
                            {%- if application in server_call_point["Applications"] %}
                            <SYNCHRONOUS-SERVER-CALL-POINT UUID="1234567{#{server_call_point["uuid"]}#}">
                              <SHORT-NAME>{{server_call_point["short_name"]}}</SHORT-NAME>
                              <OPERATION-IREF>
                                <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/AUTOSAR/Dem_swc/ComponentTypes/{{application}}/{{server_call_point["port_ref"]}}</CONTEXT-R-PORT-REF>
                                <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR/Dem_swc/Interfaces/{{server_call_point["interface_ref"]}}/{{server_call_point["operation_ref"]}}</TARGET-REQUIRED-OPERATION-REF>
                              </OPERATION-IREF>
                              <TIMEOUT>0</TIMEOUT>
                            </SYNCHRONOUS-SERVER-CALL-POINT>
                            {%- endif %}
                            {%- endfor %}
                          </SERVER-CALL-POINTS>
                          {%- endif %}
                          <SYMBOL>{{mainfunctionname}}</SYMBOL>
                        </RUNNABLE-ENTITY>
                        {%- set server_runnables_list = componenttypes_pkg["server_runnables"] %}
                        {%- for server_runnable in server_runnables_list %}
                        {%- if application in server_runnable["Applications"] %}
                        <RUNNABLE-ENTITY UUID="1234567{#{server_runnable["uuid"]}#}">
                          <SHORT-NAME>{{server_runnable["short_name"]}}</SHORT-NAME>
                          <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                          <CAN-BE-INVOKED-CONCURRENTLY>true</CAN-BE-INVOKED-CONCURRENTLY>
                          <SYMBOL>{{server_runnable["symbol"]}}</SYMBOL>
                        </RUNNABLE-ENTITY>
                        {%- endif %}
                        {%- endfor %}
                      </RUNNABLES>
                    </SWC-INTERNAL-BEHAVIOR>
                  </INTERNAL-BEHAVIORS>
                </SERVICE-SW-COMPONENT-TYPE>
                {%- endfor %}
              </ELEMENTS>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>