    "DEM013001": {
        "rule_name": "DEM013001",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of DemDataElementUsePort and DemDataElementReadFnc.",
        "rule_message": "DemDataElementReadFnc should be empty if DemDataElementUsePort is true.",
        "rule_ruleset": {
            "ruleset_01": {
                "base_path": "/AUTOSAR/EcucDefs/Dem/DemGeneral/DemDataElementClass/DemExternalCSDataElementClass",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Dem/DemGeneral/DemDataElementClass/DemExternalCSDataElementClass/DemDataElementUsePort",
                        "value_operator": "==",
                        "value": true,
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Dem/DemGeneral/DemDataElementClass/DemExternalCSDataElementClass/DemDataElementReadFnc",
                        "value_operator": "==",
                        "value": "",
                        "logical_operator": "or"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Dem/DemGeneral/DemDataElementClass/DemExternalCSDataElementClass/DemDataElementReadFnc",
                        "value_operator": "==",
                        "value": null,
                        "logical_operator": "or"
                    }
                ]
            }
        }
    },
    "DEM016013": {
        "rule_name": "DEM016013",
        "rule_type": "diff_container_linkage_check",
        "rule_summary": "The check of DemStoreImmediatelyTime value",
        "rule_message": "DemStoreImmediatelyTime value should be divisible by DemTaskTime value!",
        "rule_ruleset": {
            "ruleset_01": {
                "judgement": {
                    "mod_path": [
                        "/AUTOSAR/EcucDefs/Dem/DemGeneral/DemStoreImmediatelyTime",
                        "/AUTOSAR/EcucDefs/Dem/DemGeneral/DemTaskTime"
                    ],
                    "judge_expression": "True if %0 is None else (divmod(%0 * 1000, %1 * 1000)[1] == 0 and %0 >= %1)"
                }
            }
        }
    }
}

