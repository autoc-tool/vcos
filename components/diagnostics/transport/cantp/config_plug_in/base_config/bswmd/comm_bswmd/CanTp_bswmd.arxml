                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:30faf77d-0285-4231-96b2-aedecf133e62">
                      <SHORT-NAME>CanTpFlexibleDataRateSupport</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Enable support for CAN FD frames.</L-2>
                        <L-2 L="ZH">概述：CanTpFlexibleDataRateSupport配置项用于指定CAN传输层（CanTp模块）启用对CAN FD帧的支持。</L-2>
                        <L-2 L="ZH">注意：类型为Boolean，控制是否支持CAN FD（Flexible Data-Rate）。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanTp_00305</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
