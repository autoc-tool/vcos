{%- set mainfunction_cfg = get_mainfunction_config(CanTpConfig) %}
{%- if mainfunction_cfg | length == 0 %}
#define CANTP_CONVERT_MS_TO_MAIN_CYCLES(x)  ((x)/CANTP_MAIN_FUNCTION_PERIOD_TIME_MS)
{%- endif %}

#define CANTP_START_SEC_CONST
