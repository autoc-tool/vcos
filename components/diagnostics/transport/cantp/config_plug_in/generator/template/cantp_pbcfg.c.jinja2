#include "cantp_memmap.h"
FUNC_P2CONST(cantp_config_type, AUTOMATIC, CANTP_CODE ) cantp_get_config_ptr(void)
{
    return cantp_config_ptr;
}

FUNC(void, CANTP_CODE) cantp_set_config_ptr(const cantp_config_type* input)
{
    cantp_config_ptr = input;
    return;
}

FUNC(PduIdType, CANTP_CODE) cantp_get_pdu_index(uint32 coreid, PduIdType cantp_pdu_id)
{
    if (cantp_config_ptr == NULL) {
        return CANTP_INVALID_PDU_ID;
    }
    // 取得对应核的配置表信息
    const cantp_ipdu_config_type* core_config = &cantp_config_ptr->cantp_ipdu_channel_info[coreid];
    // 获取此核的PDU配置项
    const cantp_rx_id_type* config_table = core_config->ipdu_cfg_addr;
    const uint32 tabLen = core_config->number_of_pdus;

    for (PduIdType i = 0; i < tabLen; ++i) {
        if (config_table[i].cantp_pdu_id == cantp_pdu_id) {
            return i;
        }
    }
    return CANTP_INVALID_PDU_ID;
}
