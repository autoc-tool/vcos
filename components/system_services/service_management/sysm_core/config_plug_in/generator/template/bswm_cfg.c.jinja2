{%- set pnc = get_key_name(req_value["BswMModeRequestSource"]["BswMComMPncRequest"]["BswMComMPncRef"]["ValueRef"])%}
	case ComMConf_ComMPnc_{{pnc}}:
		bswm_mode_req_mirrors[BSWM_{{ req_name|upper }}_REQ_IDX] = (uint32)current_pnc_mode;
