			bswm_process_immediate_request({{immreq_index["ComM_Pnc"][pnc][0]}}, {{immreq_index["ComM_Pnc"][pnc][1]}});
{%- endif %}
		break;
{%- endif %}
{%- endif %}
{%- endfor %}
	default:
		break;
	}
{%- endif %}
#endif
}
