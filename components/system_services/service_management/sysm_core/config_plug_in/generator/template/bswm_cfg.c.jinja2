{%- for req_name, req_value in requests.items() %}
{%- if req_name != "Tag" %}
{%- if "BswMEcuMWakeupSource" in req_value["BswMModeRequestSource"] %}
{%- set source = get_key_name(req_value["BswMModeRequestSource"]["BswMEcuMWakeupSource"]["BswMEcuMWakeupSrcRef"]["ValueRef"])%}
