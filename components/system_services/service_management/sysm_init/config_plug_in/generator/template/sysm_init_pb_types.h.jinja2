/*!*********************************************************************************************************************
 * @brief	   启动阶段打点trace功能开启标志位
 **********************************************************************************************************************/
#define EcuM_INITPHASEDOT			  (1U)

/*!*********************************************************************************************************************
 * @brief	   Postbuild配置结构体
 **********************************************************************************************************************/
typedef struct {
	const uint32 start_pattern; ///< 启动模式模式
	const uint32 post_build_variant; ///< Postbuild变体
#ifdef CFG_POSTBUILD_PARTNUMBER
	const post_build_part_no_t part_number; ///< Postbuild部件编号
#endif
	const uint64 pre_compile_hash_low; ///< 编译时的低位MD5哈希值
	const uint64 pre_compile_hash_high; ///< 编译时的高位MD5哈希值

	{%- for module in modules %}
	{%- if module == "pdur" %}
	const pdur_pb_config_type *const {{module}}_config_ptr; ///< {{module}}的配置指针
	{%- elif module == "cannm" %}
	const cannm_cate_cfg *const {{module}}_config_ptr; ///< {{module}}的配置指针
	{%- else %}
	const {{module}}_config_type* const {{module}}_config_ptr; ///< {{module}}的配置指针
	{%- endif %}
	{%- endfor %}
	
	const uint32* const end_pattern; ///< 结束模式
} postbuild_config_t;

#if(EcuM_INITPHASEDOT == 1u)
/*!*********************************************************************************************************************
 * @brief	   EcuM零时初始化结构体
 **********************************************************************************************************************/
typedef struct ecum_init_zero_time_struct {
	{%- if "EcuMDriverInitListZero" in dict_config["ActiveEcuC"]["EcuM"]["EcuMConfiguration"]["EcuMCommonConfiguration"] %}
	{%- if "EcuMDriverInitItems" in dict_config["ActiveEcuC"]["EcuM"]["EcuMConfiguration"]["EcuMCommonConfiguration"]["EcuMDriverInitListZero"] %}
	{%- set init_items = dict_config["ActiveEcuC"]["EcuM"]["EcuMConfiguration"]["EcuMCommonConfiguration"]["EcuMDriverInitListZero"]["EcuMDriverInitItems"].items() %}

	{%- for item_name, item_value in init_items %}
	{%- if item_name != "Tag" %}
	{% set  init_zero_member=  get_initfunc_name(gen_init_func(item_name, item_value),0)  %}
	uint32 m_{{ init_zero_member }}; ///< {{ init_zero_member}} 初始化时间戳
	{%- endif %}
	{%- endfor %}
	{%- else %}
	uint8 stub; ///< 占位符
	{%- endif %}
	{%- else %}
	uint8 stub; ///< 占位符
	{%- endif %}
} ecum_init_zero_time_t;

