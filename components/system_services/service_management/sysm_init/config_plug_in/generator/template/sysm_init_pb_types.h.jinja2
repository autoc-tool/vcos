} ecum_init_core1_time_struct_t;

{%- for i in range(2,core_num) %}

/*!*********************************************************************************************************************
 * @brief	   EcuM初始化结构体核心{{i}}
 **********************************************************************************************************************/
typedef struct {{"ecum_init_core" ~ i ~ "_time_struct_t"}} {
	uint32 {{"core" ~ i ~ "_begin"}}; ///< 核心{{i}}初始化开始标志
	
	{%- if get_index("EcuMDriverInitListCore", i) in dict_config["ActiveEcuC"]["EcuM"]["EcuMConfiguration"]["EcuMFlexConfiguration"] %}
	{%- if "EcuMDriverInitItems" in dict_config["ActiveEcuC"]["EcuM"]["EcuMConfiguration"]["EcuMFlexConfiguration"][get_index("EcuMDriverInitListCore", i)] %}
	{%- set core_items = dict_config["ActiveEcuC"]["EcuM"]["EcuMConfiguration"]["EcuMFlexConfiguration"][get_index("EcuMDriverInitListCore", i)]["EcuMDriverInitItems"].items() %}
	
	{%- for item_name, item_value in core_items %}
	{%- if item_name != "Tag" %}
	{% set init_core_i_member = get_initfunc_name(gen_init_func(item_name, item_value),10+i) %}
	uint32 m_{{ init_core_i_member }}; ///< 核心{{i}}的{{ init_core_i_member }}初始化时间戳
	{%- endif %}
	{%- endfor %}
	{%- endif %}
	{%- endif %}
} {{"ecum_init_core" ~ i ~ "_time_struct_t"}};
{%- endfor %}

