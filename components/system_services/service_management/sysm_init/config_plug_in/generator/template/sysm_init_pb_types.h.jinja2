/*!*********************************************************************************************************************
 * @brief	   EcuM初始化结构体核心1
 **********************************************************************************************************************/
typedef struct ecum_init_core1_time_struct {
	uint32 core1_begin; ///< 核心1初始化开始标志
	
	{%- if "EcuMDriverInitListCore1" in dict_config["ActiveEcuC"]["EcuM"]["EcuMConfiguration"]["EcuMFlexConfiguration"] %}
	{%- if "EcuMDriverInitItems" in dict_config["ActiveEcuC"]["EcuM"]["EcuMConfiguration"]["EcuMFlexConfiguration"]["EcuMDriverInitListCore1"] %}
	{%- set core_items = dict_config["ActiveEcuC"]["EcuM"]["EcuMConfiguration"]["EcuMFlexConfiguration"]["EcuMDriverInitListCore1"]["EcuMDriverInitItems"].items() %}
	
	{%- for item_name, item_value in core_items %}
