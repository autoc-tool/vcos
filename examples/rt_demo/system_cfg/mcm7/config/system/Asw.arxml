                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
              <TYPE-EMITTER>Platform_Type</TYPE-EMITTER>
            </IMPLEMENTATION-DATA-TYPE>
