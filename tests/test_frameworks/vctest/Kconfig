config UNITY_FRAMEWORK
	bool "unity framework"
	default n
	---help---
		Enable the os UNITY_FRAMEWORK.

if UNITY_FRAMEWORK

config UNITY_FRAMEWORK_PROGNAME
	string "unity program name"
	default "ut"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config UNITY_FRAMEWORK_PRIORITY
	int "unity framework task priority"
	default 100

config UNITY_FRAMEWORK_STACKSIZE
	int "unity framework task stack size"
	default DEFAULT_TASK_STACKSIZE

endif # UNITY_FRAMEWORK