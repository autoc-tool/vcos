cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    cpuId: 0
    nvic: nvic0

cpu1: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    cpuId: 1
    nvic: nvic1
    init:
        IsHalted true
    reset:
        IsHalted true

cpu2: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    cpuId: 2
    nvic: nvic2
    init:
        IsHalted true
    reset:
        IsHalted true

cpu3: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    cpuId: 3
    nvic: nvic3
    init:
        IsHalted true
    reset:
        IsHalted true

nvic0: IRQControllers.NVIC @ sysbus new Bus.BusPointRegistration { address: 0xE000E000; cpu: cpu0 }
    priorityMask: 0xE0
    systickFrequency: 160000000
    -> cpu0@0

nvic1: IRQControllers.NVIC @ sysbus new Bus.BusPointRegistration { address: 0xE000E000; cpu: cpu1 }
    priorityMask: 0xE0
    systickFrequency: 160000000
    -> cpu1@0

nvic2: IRQControllers.NVIC @ sysbus new Bus.BusPointRegistration { address: 0xE000E000; cpu: cpu2 }
    priorityMask: 0xE0
    systickFrequency: 160000000
    -> cpu2@0

nvic3: IRQControllers.NVIC @ sysbus new Bus.BusPointRegistration { address: 0xE000E000; cpu: cpu3 }
    priorityMask: 0xE0
    systickFrequency: 160000000
    -> cpu3@0

dwt0: Miscellaneous.DWT @ sysbus new Bus.BusPointRegistration { address: 0xE0001000; cpu: cpu0 }
    frequency: 160000000

dwt1: Miscellaneous.DWT @ sysbus new Bus.BusPointRegistration { address: 0xE0001000; cpu: cpu1 }
    frequency: 160000000

dwt2: Miscellaneous.DWT @ sysbus new Bus.BusPointRegistration { address: 0xE0001000; cpu: cpu2 }
    frequency: 160000000

dwt3: Miscellaneous.DWT @ sysbus new Bus.BusPointRegistration { address: 0xE0001000; cpu: cpu3 }
    frequency: 160000000

coreid0: Memory.MappedMemory @ sysbus new Bus.BusPointRegistration { address: 0x40000000; cpu: cpu0 }
    size: 0x4

coreid1: Memory.MappedMemory @ sysbus new Bus.BusPointRegistration { address: 0x40000000; cpu: cpu1 }
    size: 0x4

coreid2: Memory.MappedMemory @ sysbus new Bus.BusPointRegistration { address: 0x40000000; cpu: cpu2 }
    size: 0x4

coreid3: Memory.MappedMemory @ sysbus new Bus.BusPointRegistration { address: 0x40000000; cpu: cpu3 }
    size: 0x4

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x800000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x200000
