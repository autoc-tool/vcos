:name: autoc mcm7
:description: Three Cortex-M7 cores, one ELF. Console is Segger RTT.

using sysbus

$name?="mcm7"
$bin?=$ORIGIN/../../../../../output/rt_demo_mcm7_gcc/rt_demo.elf

mach create $name
machine LoadPlatformDescription $ORIGIN/mcm7.repl

include @scripts/single-node/segger-rtt.py

macro reset
"""
    sysbus LoadELF $bin
    sysbus.coreid0 WriteDoubleWord 0 0
    sysbus.coreid1 WriteDoubleWord 0 1
    sysbus.coreid2 WriteDoubleWord 0 2
    sysbus.cpu0 Reset
    sysbus.cpu1 Reset
    sysbus.cpu2 Reset
"""
runMacro $reset

machine CreateVirtualConsole "segger_rtt"
setup_segger_rtt sysbus.segger_rtt false true true true true
showAnalyzer sysbus.segger_rtt
