:name: autoc scm7
:description: Single Cortex-M7. Console is Segger RTT.

using sysbus

$name?="scm7"
$bin?=$ORIGIN/../../../../../output/rt_demo_scm7_gcc/rt_demo.elf

mach create $name
machine LoadPlatformDescription $ORIGIN/scm7.repl

include @scripts/single-node/segger-rtt.py

macro reset
"""
    sysbus LoadELF $bin
    sysbus.cpu Reset
"""
runMacro $reset

machine CreateVirtualConsole "segger_rtt"
setup_segger_rtt sysbus.segger_rtt false true true true true
showAnalyzer sysbus.segger_rtt
